{"code":"ru","es":"Ruso","en":"Russian","native":"Русский","tts":"ru-RU","entries":[{"sec":"0. El alfabeto cirílico","w":"Я студент.","es":"Soy estudiante.","note":"Regla: En presente no se usa el verbo «ser / estar»."},{"sec":"0. El alfabeto cirílico","w":"Это мой брат.","es":"Este es mi hermano.","note":"Regla: это = «esto es / este es», invariable."},{"sec":"0. El alfabeto cirílico","w":"У меня есть машина.","es":"Tengo coche.","note":"Regla: «Tener» se dice у + genitivo + есть."},{"sec":"0. El alfabeto cirílico","w":"У меня нет машины.","es":"No tengo coche.","note":"Regla: нет + genitivo = «no hay / no tengo»."},{"sec":"0. El alfabeto cirílico","w":"Здесь есть кафе?","es":"¿Hay una cafetería aquí?","note":"Regla: есть = «hay»."},{"sec":"1. Pronombres personales","w":"себя","es":"a sí mismo (todas las personas)","ex":"Я купил себе книгу.","exEs":"Me compré un libro.","tr":"sebiá"},{"sec":"1. Pronombres personales","w":"-ся / -сь","es":"se (verbos reflexivos)","ex":"Он моется. Я учусь.","exEs":"Se lava. Estudio.","tr":"-sia"},{"sec":"1. Pronombres personales","w":"друг друга","es":"mutuamente","ex":"Мы любим друг друга.","exEs":"Nos queremos.","tr":"drug drúga"},{"sec":"1. Pronombres personales","w":"сам, сама, сами","es":"mismo, uno mismo","ex":"Я сам это сделал.","exEs":"Lo hice yo mismo.","tr":"sam"},{"sec":"1. Pronombres personales","w":"свой, своя, своё, свои","es":"su propio (del sujeto)","ex":"Он любит свою жену.","exEs":"Quiere a su (propia) mujer.","tr":"svoi"},{"sec":"2. Preposiciones","w":"без","es":"sin","ex":"Кофе без сахара.","exEs":"Café sin azúcar.","tr":"bez"},{"sec":"2. Preposiciones","w":"для","es":"para","ex":"Это для тебя.","exEs":"Es para ti.","tr":"dlia"},{"sec":"2. Preposiciones","w":"до","es":"hasta; antes de","ex":"До завтра! До обеда.","exEs":"¡Hasta mañana! Antes de comer.","tr":"do"},{"sec":"2. Preposiciones","w":"из","es":"de (dentro de; origen) · de, desde","ex":"Я из Испании. Из дома.","exEs":"Soy de España. De casa.","tr":"iz"},{"sec":"2. Preposiciones","w":"от","es":"de (persona, punto) · de, desde","ex":"Письмо от мамы. Далеко от центра.","exEs":"Carta de mamá. Lejos del centro.","tr":"ot"},{"sec":"2. Preposiciones","w":"с (со)","es":"de, desde (superficie, на-lugares)","ex":"С работы. С утра.","exEs":"Del trabajo. Desde por la mañana.","tr":"s"},{"sec":"2. Preposiciones","w":"у","es":"en casa de; junto a; (tener)","ex":"У друга. У окна. У меня есть…","exEs":"En casa de un amigo. Junto a la ventana. Tengo…","tr":"u"},{"sec":"2. Preposiciones","w":"около","es":"cerca de; aproximadamente · cerca; aprox.","ex":"Около дома. Около часа.","exEs":"Cerca de casa. Una hora aprox.","tr":"ókolo"},{"sec":"2. Preposiciones","w":"после","es":"después de","ex":"После работы.","exEs":"Después del trabajo.","tr":"pósle"},{"sec":"2. Preposiciones","w":"из-за","es":"por culpa de","ex":"Из-за дождя.","exEs":"Por culpa de la lluvia.","tr":"iz-za"},{"sec":"2. Preposiciones","w":"кроме","es":"excepto, además de","ex":"Все, кроме меня.","exEs":"Todos excepto yo.","tr":"króme"},{"sec":"2. Preposiciones","w":"вместо","es":"en lugar de","ex":"Вместо чая.","exEs":"En lugar de té.","tr":"vmésto"},{"sec":"2. Preposiciones","w":"против","es":"contra","ex":"Я против.","exEs":"Estoy en contra.","tr":"prótiv"},{"sec":"2. Preposiciones","w":"вокруг","es":"alrededor de","ex":"Вокруг дома.","exEs":"Alrededor de la casa.","tr":"vokrúg"},{"sec":"2. Preposiciones","w":"напротив","es":"enfrente de","ex":"Напротив банка.","exEs":"Enfrente del banco.","tr":"naprótiv"},{"sec":"2. Preposiciones","w":"мимо","es":"por delante de","ex":"Мимо школы.","exEs":"Por delante de la escuela.","tr":"mímo"},{"sec":"2. Preposiciones","w":"во время","es":"durante","ex":"Во время урока.","exEs":"Durante la clase.","tr":"vo vrémia"},{"sec":"2. Preposiciones","w":"среди","es":"entre (un grupo)","ex":"Среди друзей.","exEs":"Entre amigos.","tr":"sredí"},{"sec":"2. Preposiciones","w":"к (ко)","es":"hacia; a (personas)","ex":"Я иду к врачу. К вечеру.","exEs":"Voy al médico. Hacia la tarde.","tr":"k"},{"sec":"2. Preposiciones","w":"по","es":"por (superficie); por (medio); según; los (días)","ex":"По улице. По телефону. По понедельникам.","exEs":"Por la calle. Por teléfono. Los lunes.","tr":"po"},{"sec":"2. Preposiciones","w":"благодаря","es":"gracias a","ex":"Благодаря тебе.","exEs":"Gracias a ti.","tr":"blagodariá"},{"sec":"2. Preposiciones","w":"в (во)","es":"a (dirección a un interior); día, hora","ex":"Я иду в школу. В понедельник. В пять часов.","exEs":"Voy a la escuela. El lunes. A las cinco.","tr":"v"},{"sec":"2. Preposiciones","w":"на","es":"a (dirección a на-lugares); para (duración) · en, sobre; a","ex":"Я иду на работу. На неделю.","exEs":"Voy al trabajo. Para una semana.","tr":"na"},{"sec":"2. Preposiciones","w":"через","es":"a través de; dentro de (tiempo)","ex":"Через парк. Через час.","exEs":"Por el parque. Dentro de una hora.","tr":"chérez"},{"sec":"2. Preposiciones","w":"за","es":"por (gracias por); en (tiempo que se tarda) · detrás; por","ex":"Спасибо за помощь. За час.","exEs":"Gracias por la ayuda. En una hora.","tr":"za"},{"sec":"2. Preposiciones","w":"про","es":"sobre (coloquial)","ex":"Фильм про войну.","exEs":"Una película sobre la guerra.","tr":"pro"},{"sec":"2. Preposiciones","w":"назад","es":"hace (tiempo) · hace; atrás","ex":"Два года назад.","exEs":"Hace dos años.","tr":"nazád (detrás)"},{"sec":"2. Preposiciones","w":"с (со)","es":"con","ex":"С другом. Кофе с молоком.","exEs":"Con un amigo. Café con leche.","tr":"s"},{"sec":"2. Preposiciones","w":"за","es":"detrás de; (ir) a por","ex":"За домом. Я иду за хлебом.","exEs":"Detrás de la casa. Voy a por pan.","tr":"za"},{"sec":"2. Preposiciones","w":"под","es":"debajo de","ex":"Под столом.","exEs":"Debajo de la mesa.","tr":"pod"},{"sec":"2. Preposiciones","w":"над","es":"encima de (sin tocar)","ex":"Над городом.","exEs":"Sobre la ciudad.","tr":"nad"},{"sec":"2. Preposiciones","w":"перед","es":"delante de; antes de","ex":"Перед домом. Перед ужином.","exEs":"Delante de la casa. Antes de cenar.","tr":"péred"},{"sec":"2. Preposiciones","w":"между","es":"entre","ex":"Между нами.","exEs":"Entre nosotros.","tr":"mézhdu"},{"sec":"2. Preposiciones","w":"рядом с","es":"al lado de","ex":"Рядом с метро.","exEs":"Al lado del metro.","tr":"riádom s"},{"sec":"2. Preposiciones","w":"в (во)","es":"en (dentro de); mes, año","ex":"В Москве. В мае. В 2026 году.","exEs":"En Moscú. En mayo. En 2026.","tr":"v"},{"sec":"2. Preposiciones","w":"на","es":"en, sobre (superficie, на-lugares)","ex":"На столе. На работе.","exEs":"Sobre la mesa. En el trabajo.","tr":"na"},{"sec":"2. Preposiciones","w":"о (об, обо)","es":"sobre, acerca de","ex":"О чём ты думаешь? Об этом.","exEs":"¿En qué piensas? En eso.","tr":"o"},{"sec":"2. Preposiciones","w":"при","es":"en presencia de; en tiempos de","ex":"При мне. При Петре I.","exEs":"Delante de mí. En tiempos de Pedro I.","tr":"pri"},{"sec":"4. Demostrativos","w":"это","es":"esto es, este es (invariable)","ex":"Это мой брат. Это моя мама. Что это?","exEs":"Este es mi hermano. Esta es mi madre. ¿Qué es esto?","tr":"éto"},{"sec":"4. Demostrativos","w":"этот, эта, это, эти","es":"este, esta, estos","ex":"Этот дом. Эта книга. Эти люди.","exEs":"Esta casa. Este libro. Esta gente.","tr":"étot"},{"sec":"4. Demostrativos","w":"тот, та, то, те","es":"ese, aquel","ex":"Тот дом, а не этот.","exEs":"Esa casa, no esta.","tr":"tot"},{"sec":"4. Demostrativos","w":"такой, такая…","es":"tal, así","ex":"Такой хороший день!","exEs":"¡Qué día tan bueno!","tr":"takói"},{"sec":"4. Demostrativos","w":"так","es":"así; tan","ex":"Так нельзя. Так красиво!","exEs":"Así no se puede. ¡Qué bonito!","tr":"tak"},{"sec":"4. Demostrativos","w":"тот же (самый)","es":"el mismo","ex":"Тот же день. То же самое.","exEs":"El mismo día. Lo mismo.","tr":"tot zhe"},{"sec":"4. Demostrativos","w":"весь, вся, всё, все","es":"todo, toda, todo, todos","ex":"Весь день. Всё хорошо. Все знают.","exEs":"Todo el día. Todo bien. Todos lo saben.","tr":"ves"},{"sec":"5. Interrogativos","w":"кто","es":"¿quién?","ex":"Кто это?","exEs":"¿Quién es?","tr":"kto"},{"sec":"5. Interrogativos","w":"что","es":"¿qué? · qué; que","ex":"Что ты делаешь?","exEs":"¿Qué haces?","tr":"shto"},{"sec":"5. Interrogativos","w":"какой, какая, какое, какие","es":"¿qué?, ¿cuál?, ¿cómo es?","ex":"Какой цвет? Какая погода?","exEs":"¿Qué color? ¿Qué tiempo hace?","tr":"kakói"},{"sec":"5. Interrogativos","w":"который","es":"¿cuál (de varios)?; ¿qué (hora)? · que, el cual","ex":"Который час?","exEs":"¿Qué hora es?","tr":"kotóry"},{"sec":"5. Interrogativos","w":"чей, чья, чьё, чьи","es":"¿de quién?","ex":"Чья это сумка?","exEs":"¿De quién es este bolso?","tr":"chei"},{"sec":"5. Interrogativos","w":"где","es":"¿dónde?","ex":"Где ты живёшь?","exEs":"¿Dónde vives?","tr":"gde"},{"sec":"5. Interrogativos","w":"куда","es":"¿adónde?","ex":"Куда ты идёшь?","exEs":"¿Adónde vas?","tr":"kudá"},{"sec":"5. Interrogativos","w":"откуда","es":"¿de dónde?","ex":"Откуда вы?","exEs":"¿De dónde es usted?","tr":"otkúda"},{"sec":"5. Interrogativos","w":"когда","es":"¿cuándo?","ex":"Когда ты придёшь?","exEs":"¿Cuándo vendrás?","tr":"kogdá"},{"sec":"5. Interrogativos","w":"как","es":"¿cómo? · cómo; como","ex":"Как дела? Как тебя зовут?","exEs":"¿Qué tal? ¿Cómo te llamas?","tr":"kak"},{"sec":"5. Interrogativos","w":"почему","es":"¿por qué?","ex":"Почему ты смеёшься?","exEs":"¿Por qué te ríes?","tr":"pochemú"},{"sec":"5. Interrogativos","w":"зачем","es":"¿para qué?","ex":"Зачем тебе это?","exEs":"¿Para qué quieres eso?","tr":"zachém"},{"sec":"5. Interrogativos","w":"сколько","es":"¿cuánto?, ¿cuántos?","ex":"Сколько стоит? Сколько тебе лет?","exEs":"¿Cuánto cuesta? ¿Cuántos años tienes?","tr":"skólko (+ G)"},{"sec":"5. Interrogativos","w":"во сколько","es":"¿a qué hora?","ex":"Во сколько начинается?","exEs":"¿A qué hora empieza?","tr":"vo skólko"},{"sec":"5. Interrogativos","w":"как долго","es":"¿cuánto tiempo?","ex":"Как долго ты здесь?","exEs":"¿Cuánto tiempo llevas aquí?","tr":"kak dólgo"},{"sec":"6. Relativos","w":"что","es":"que; lo que","ex":"Всё, что я знаю. Я думаю, что…","exEs":"Todo lo que sé. Creo que…","tr":"shto"},{"sec":"6. Relativos","w":"то, что","es":"lo que","ex":"Я понимаю то, что ты говоришь.","exEs":"Entiendo lo que dices.","tr":"to, shto"},{"sec":"6. Relativos","w":"кто","es":"quien","ex":"Тот, кто знает…","exEs":"El que sabe…","tr":"kto"},{"sec":"6. Relativos","w":"где / куда","es":"donde / adonde","ex":"Город, где я живу.","exEs":"La ciudad donde vivo.","tr":"gde / kudá"},{"sec":"6. Relativos","w":"когда","es":"cuando, en que","ex":"День, когда он родился.","exEs":"El día en que nació.","tr":"kogdá"},{"sec":"6. Relativos","w":"чей","es":"cuyo · de quién","ex":"Человек, чья машина…","exEs":"El hombre cuyo coche…","tr":"chei"},{"sec":"7. Conjunciones","w":"и","es":"y; también","ex":"Мама и папа. И я тоже.","exEs":"Mamá y papá. Y yo también.","tr":"i"},{"sec":"7. Conjunciones","w":"а","es":"y, pero (contraste); en cambio","ex":"Я студент, а он врач. Не чай, а кофе.","exEs":"Yo soy estudiante y él, médico. No té, sino café.","tr":"a"},{"sec":"7. Conjunciones","w":"но","es":"pero (contradice lo esperado)","ex":"Я устал, но работаю.","exEs":"Estoy cansado, pero trabajo.","tr":"no"},{"sec":"7. Conjunciones","w":"или","es":"o","ex":"Чай или кофе?","exEs":"¿Té o café?","tr":"íli"},{"sec":"7. Conjunciones","w":"или… или","es":"o… o","ex":"Или сегодня, или завтра.","exEs":"O hoy o mañana.","tr":"íli… íli"},{"sec":"7. Conjunciones","w":"и… и","es":"tanto… como","ex":"И я, и он.","exEs":"Tanto yo como él.","tr":"i… i"},{"sec":"7. Conjunciones","w":"ни… ни","es":"ni… ni (con не)","ex":"Я не пью ни чай, ни кофе.","exEs":"No bebo ni té ni café.","tr":"ni… ni"},{"sec":"7. Conjunciones","w":"не только… но и","es":"no solo… sino también","ex":"Не только красиво, но и дёшево.","exEs":"No solo bonito, sino también barato.","tr":"ne tólko… no i"},{"sec":"7. Conjunciones","w":"то есть","es":"es decir, o sea","ex":"Завтра, то есть в субботу.","exEs":"Mañana, o sea, el sábado.","tr":"to yest"},{"sec":"7. Conjunciones","w":"зато","es":"pero a cambio","ex":"Дорого, зато хорошо.","exEs":"Es caro, pero a cambio es bueno.","tr":"zató"},{"sec":"7. Conjunciones","w":"однако","es":"sin embargo","ex":"Однако это не так.","exEs":"Sin embargo, no es así.","tr":"odnáko"},{"sec":"7. Conjunciones","w":"поэтому","es":"por eso","ex":"Идёт дождь, поэтому я дома.","exEs":"Llueve, por eso estoy en casa.","tr":"poétomu"},{"sec":"7. Conjunciones","w":"так что","es":"así que","ex":"Я устал, так что иду спать.","exEs":"Estoy cansado, así que me voy a dormir.","tr":"tak shto"},{"sec":"7. Conjunciones","w":"потом / затем","es":"luego, después","ex":"Сначала ем, потом иду.","exEs":"Primero como, luego me voy.","tr":"potóm / zatém"},{"sec":"7. Conjunciones","w":"тоже / также","es":"también","ex":"Я тоже. Я также говорю по-английски.","exEs":"Yo también. También hablo inglés.","tr":"tózhe / tákzhe"},{"sec":"7. Conjunciones","w":"всё-таки / всё равно","es":"aun así / da igual","ex":"Идёт дождь, но я всё равно пойду.","exEs":"Llueve, pero iré de todas formas.","tr":"vsyo-táki / vsyo ravnó"},{"sec":"7. Conjunciones","w":"иначе / а то","es":"si no, de lo contrario","ex":"Быстрее, а то опоздаем.","exEs":"Más rápido, que si no llegamos tarde.","tr":"ináche / a to"},{"sec":"7. Conjunciones","w":"что","es":"que","ex":"Я думаю, что он прав.","exEs":"Creo que tiene razón.","tr":"shto"},{"sec":"7. Conjunciones","w":"потому что","es":"porque","ex":"Я дома, потому что идёт дождь.","exEs":"Estoy en casa porque llueve.","tr":"potomú shto"},{"sec":"7. Conjunciones","w":"так как","es":"ya que, como","ex":"Так как поздно, я иду домой.","exEs":"Como es tarde, me voy a casa.","tr":"tak kak"},{"sec":"7. Conjunciones","w":"чтобы","es":"para (que)","ex":"Я учу русский, чтобы работать в Москве.","exEs":"Estudio ruso para trabajar en Moscú.","tr":"shtóby"},{"sec":"7. Conjunciones","w":"если","es":"si (condición real)","ex":"Если хочешь, я приду.","exEs":"Si quieres, voy.","tr":"yésli"},{"sec":"7. Conjunciones","w":"если бы… бы","es":"si… -ría (irreal)","ex":"Если бы я знал, я бы сказал.","exEs":"Si lo hubiera sabido, lo habría dicho.","tr":"yésli by"},{"sec":"7. Conjunciones","w":"ли","es":"si (pregunta indirecta) · si (interrog.)","ex":"Не знаю, придёт ли он.","exEs":"No sé si vendrá.","tr":"li"},{"sec":"7. Conjunciones","w":"когда","es":"cuando","ex":"Когда я был маленьким, …","exEs":"Cuando era pequeño…","tr":"kogdá"},{"sec":"7. Conjunciones","w":"пока","es":"mientras · mientras; adiós","ex":"Пока я готовлю, слушаю музыку.","exEs":"Mientras cocino, escucho música.","tr":"poká"},{"sec":"7. Conjunciones","w":"пока не","es":"hasta que","ex":"Жди, пока я не приду.","exEs":"Espera hasta que yo llegue.","tr":"poká ne"},{"sec":"7. Conjunciones","w":"хотя","es":"aunque","ex":"Хотя я устал, я работаю.","exEs":"Aunque estoy cansado, trabajo.","tr":"jotiá"},{"sec":"7. Conjunciones","w":"несмотря на то что","es":"a pesar de que","ex":"Несмотря на то что шёл дождь, …","exEs":"A pesar de que llovía…","tr":"nesmotriá na to shto"},{"sec":"7. Conjunciones","w":"как только","es":"en cuanto","ex":"Как только смогу, позвоню.","exEs":"En cuanto pueda, llamo.","tr":"kak tólko"},{"sec":"7. Conjunciones","w":"перед тем как / прежде чем","es":"antes de (que)","ex":"Перед тем как уйти, поешь.","exEs":"Antes de irte, come.","tr":"péred tem kak"},{"sec":"7. Conjunciones","w":"после того как","es":"después de que","ex":"После того как он ушёл, …","exEs":"Después de que se fue…","tr":"pósle tovó kak"},{"sec":"7. Conjunciones","w":"с тех пор как","es":"desde que","ex":"С тех пор как я здесь живу, …","exEs":"Desde que vivo aquí…","tr":"s tej por kak"},{"sec":"7. Conjunciones","w":"как будто","es":"como si","ex":"Он говорит, как будто всё знает.","exEs":"Habla como si lo supiera todo.","tr":"kak búdto"},{"sec":"7. Conjunciones","w":"чем… тем","es":"cuanto más… más","ex":"Чем больше, тем лучше.","exEs":"Cuanto más, mejor.","tr":"chem… tem"},{"sec":"8. Indefinidos y cuantificadores","w":"все / всё","es":"todos / todo","ex":"Все здесь. Всё понятно.","exEs":"Están todos. Todo claro.","tr":"vse / vsyo"},{"sec":"8. Indefinidos y cuantificadores","w":"каждый","es":"cada","ex":"Каждый день.","exEs":"Cada día.","tr":"kázhdy"},{"sec":"8. Indefinidos y cuantificadores","w":"любой","es":"cualquier","ex":"В любое время.","exEs":"A cualquier hora.","tr":"liubói"},{"sec":"8. Indefinidos y cuantificadores","w":"другой","es":"otro","ex":"Другой день. Другие люди.","exEs":"Otro día. Otra gente.","tr":"drugói"},{"sec":"8. Indefinidos y cuantificadores","w":"оба / обе","es":"ambos / ambas","ex":"Оба брата.","exEs":"Los dos hermanos.","tr":"óba / óbe"},{"sec":"8. Indefinidos y cuantificadores","w":"некоторые","es":"algunos","ex":"Некоторые люди.","exEs":"Algunas personas.","tr":"nekótorye"},{"sec":"8. Indefinidos y cuantificadores","w":"несколько","es":"varios, unos cuantos","ex":"Несколько дней.","exEs":"Unos días.","tr":"néskolko (+ G pl.)"},{"sec":"8. Indefinidos y cuantificadores","w":"много","es":"mucho, muchos","ex":"Много времени. Много людей.","exEs":"Mucho tiempo. Mucha gente.","tr":"mnógo (+ G)"},{"sec":"8. Indefinidos y cuantificadores","w":"мало","es":"poco, pocos","ex":"Мало денег.","exEs":"Poco dinero.","tr":"málo (+ G)"},{"sec":"8. Indefinidos y cuantificadores","w":"немного","es":"un poco","ex":"Немного сахара.","exEs":"Un poco de azúcar.","tr":"nemnógo (+ G)"},{"sec":"8. Indefinidos y cuantificadores","w":"столько","es":"tanto","ex":"Столько работы!","exEs":"¡Cuánto trabajo!","tr":"stólko"},{"sec":"8. Indefinidos y cuantificadores","w":"больше / меньше","es":"más / menos","ex":"Больше нет.","exEs":"Ya no hay más.","tr":"bólshe / ménshe"},{"sec":"8. Indefinidos y cuantificadores","w":"слишком","es":"demasiado","ex":"Слишком дорого.","exEs":"Demasiado caro.","tr":"slíshkom"},{"sec":"8. Indefinidos y cuantificadores","w":"достаточно","es":"suficiente","ex":"Достаточно времени.","exEs":"Tiempo suficiente.","tr":"dostátochno"},{"sec":"8. Indefinidos y cuantificadores","w":"очень","es":"muy; mucho","ex":"Очень хорошо. Я очень люблю…","exEs":"Muy bien. Me gusta mucho…","tr":"óchen"},{"sec":"8. Indefinidos y cuantificadores","w":"совсем","es":"del todo","ex":"Совсем один.","exEs":"Completamente solo.","tr":"sovsém"},{"sec":"8. Indefinidos y cuantificadores","w":"ещё","es":"más; todavía","ex":"Ещё кофе? Ещё раз.","exEs":"¿Más café? Otra vez.","tr":"yeschó"},{"sec":"9. La negación","w":"не","es":"no (delante de lo negado)","ex":"Я не знаю. Не сегодня.","exEs":"No sé. Hoy no.","tr":"ne"},{"sec":"9. La negación","w":"нет","es":"no (respuesta); no hay (+ G)","ex":"Нет, спасибо. Здесь нет воды.","exEs":"No, gracias. Aquí no hay agua.","tr":"net"},{"sec":"9. La negación","w":"никто не","es":"nadie","ex":"Никто не знает.","exEs":"Nadie lo sabe.","tr":"niktó ne"},{"sec":"9. La negación","w":"ничего не","es":"nada","ex":"Я ничего не вижу.","exEs":"No veo nada.","tr":"nichevó ne"},{"sec":"9. La negación","w":"никогда не","es":"nunca","ex":"Я никогда не пью кофе.","exEs":"Nunca tomo café.","tr":"nikogdá ne"},{"sec":"9. La negación","w":"нигде не","es":"en ninguna parte","ex":"Я нигде не был.","exEs":"No he estado en ninguna parte.","tr":"nigdé ne"},{"sec":"9. La negación","w":"никуда не","es":"a ninguna parte","ex":"Я никуда не иду.","exEs":"No voy a ninguna parte.","tr":"nikudá ne"},{"sec":"9. La negación","w":"никакой не","es":"ningún","ex":"Никакой проблемы нет.","exEs":"No hay ningún problema.","tr":"nikakói ne"},{"sec":"9. La negación","w":"ни один","es":"ni uno","ex":"Ни одного человека.","exEs":"Ni una sola persona.","tr":"ni odín"},{"sec":"9. La negación","w":"больше не / уже не","es":"ya no","ex":"Я здесь больше не живу.","exEs":"Ya no vivo aquí.","tr":"bólshe ne"},{"sec":"9. La negación","w":"ещё не","es":"todavía no","ex":"Он ещё не пришёл.","exEs":"Todavía no ha llegado.","tr":"yeschó ne"},{"sec":"9. La negación","w":"совсем не / вообще не","es":"en absoluto","ex":"Э