{"code":"nl","es":"Neerlandés","en":"Dutch","native":"Nederlands","tts":"nl-NL","entries":[{"sec":"1. Artículos","w":"de","note":"Uso: Palabras comunes (singular) y TODOS los plurales","ex":"de man, de vrouw, de huizen","exEs":"el hombre, la mujer, las casas","es":"el, la, los, las"},{"sec":"1. Artículos","w":"het ('t)","note":"Uso: Palabras neutras (singular)","ex":"het huis, het kind","exEs":"la casa, el niño"},{"sec":"1. Artículos","w":"een ('n)","note":"Uso: Un, una (para de y het). Se pronuncia [ən]","ex":"een man, een huis","exEs":"un hombre, una casa"},{"sec":"1. Artículos","w":"één","note":"Uso: Uno (número, con acentos)","ex":"Ik heb één broer.","exEs":"Tengo un (solo) hermano."},{"sec":"1. Artículos","w":"geen","note":"Uso: Ningún, no (artículo negativo)","ex":"Ik heb geen auto.","exEs":"No tengo coche.","es":"ningún, no"},{"sec":"1. Artículos","w":"Ik drink water.","es":"Bebo agua.","note":"Regla: Sin artículo para cantidades no contadas."},{"sec":"1. Artículos","w":"Ik ben leraar.","es":"Soy profesor.","note":"Regla: Profesiones y nacionalidades sin artículo."},{"sec":"1. Artículos","w":"Nederland, Spanje","es":"Países Bajos, España","note":"Regla: Países sin artículo (excepto de Verenigde Staten, de Filipijnen…)."},{"sec":"1. Artículos","w":"'s morgens, 's avonds","es":"por la mañana, por la noche","note":"Regla: 's es un viejo genitivo que solo queda en expresiones de tiempo."},{"sec":"1. Artículos","w":"Jans auto / de auto van Jan","es":"el coche de Jan","note":"Regla: Posesión con -s (nombres propios) o con van."},{"sec":"4. Preposiciones","w":"aan","es":"a; en (pared, borde)","ex":"Ik geef het aan Piet. Aan de muur. Aan zee.","exEs":"Se lo doy a Piet. En la pared. En la costa."},{"sec":"4. Preposiciones","w":"achter","es":"detrás de · detrás (de)","ex":"Achter het huis.","exEs":"Detrás de la casa."},{"sec":"4. Preposiciones","w":"bij","es":"en casa de; cerca de; en (empresa)","ex":"Bij mijn ouders. Ik werk bij Philips.","exEs":"En casa de mis padres. Trabajo en Philips."},{"sec":"4. Preposiciones","w":"boven","es":"encima de · encima; arriba","ex":"Boven de tafel.","exEs":"Encima de la mesa."},{"sec":"4. Preposiciones","w":"buiten","es":"fuera de","ex":"Buiten de stad.","exEs":"Fuera de la ciudad."},{"sec":"4. Preposiciones","w":"door","es":"por (agente); a través de","ex":"Geschreven door Mulisch. Door het park.","exEs":"Escrito por Mulisch. Por el parque."},{"sec":"4. Preposiciones","w":"in","es":"en, dentro de","ex":"In Amsterdam. In de kast.","exEs":"En Ámsterdam. En el armario."},{"sec":"4. Preposiciones","w":"langs","es":"por delante de; a lo largo de","ex":"Ik kom morgen langs. Langs de rivier.","exEs":"Mañana me paso. A lo largo del río."},{"sec":"4. Preposiciones","w":"met","es":"con; en (transporte)","ex":"Met jou. Met de trein.","exEs":"Contigo. En tren."},{"sec":"4. Preposiciones","w":"na","es":"después de","ex":"Na het eten.","exEs":"Después de comer."},{"sec":"4. Preposiciones","w":"naar","es":"a, hacia (dirección)","ex":"Ik ga naar Utrecht.","exEs":"Voy a Utrecht."},{"sec":"4. Preposiciones","w":"naast","es":"al lado de","ex":"Naast de bank.","exEs":"Al lado del banco."},{"sec":"4. Preposiciones","w":"om","es":"a las (hora); alrededor de","ex":"Om acht uur. Om de hoek.","exEs":"A las ocho. A la vuelta de la esquina."},{"sec":"4. Preposiciones","w":"onder","es":"debajo de; entre","ex":"Onder het bed. Onder vrienden.","exEs":"Debajo de la cama. Entre amigos."},{"sec":"4. Preposiciones","w":"op","es":"sobre, en (superficies, días, calle…)","ex":"Op de tafel. Op maandag. Op straat.","exEs":"Sobre la mesa. El lunes. En la calle."},{"sec":"4. Preposiciones","w":"over","es":"sobre (tema); dentro de (tiempo); y (hora)","ex":"Een boek over Rembrandt. Over een uur. Tien over vier.","exEs":"Un libro sobre Rembrandt. Dentro de una hora. Las cuatro y diez."},{"sec":"4. Preposiciones","w":"per","es":"por (cada)","ex":"Twee keer per dag.","exEs":"Dos veces al día."},{"sec":"4. Preposiciones","w":"sinds","es":"desde · desde (que)","ex":"Sinds 2020.","exEs":"Desde 2020."},{"sec":"4. Preposiciones","w":"te","es":"en, a (expresiones fijas) · demasiado; a, en","ex":"Te voet. Te laat. Te koop.","exEs":"A pie. Demasiado tarde. Se vende."},{"sec":"4. Preposiciones","w":"tegen","es":"contra; a (hablar a); hacia (hora)","ex":"Tegen de muur. Ik zei tegen hem… Tegen achten.","exEs":"Contra la pared. Le dije… Sobre las ocho."},{"sec":"4. Preposiciones","w":"tegenover","es":"enfrente de","ex":"Tegenover het station.","exEs":"Enfrente de la estación."},{"sec":"4. Preposiciones","w":"tijdens","es":"durante","ex":"Tijdens de les.","exEs":"Durante la clase."},{"sec":"4. Preposiciones","w":"tot","es":"hasta","ex":"Tot morgen! Tot vijf uur.","exEs":"¡Hasta mañana! Hasta las cinco."},{"sec":"4. Preposiciones","w":"tussen","es":"entre","ex":"Tussen jou en mij.","exEs":"Entre tú y yo."},{"sec":"4. Preposiciones","w":"uit","es":"de (origen); de dentro","ex":"Ik kom uit Spanje. Uit de kast.","exEs":"Soy de España. (Sacar) del armario."},{"sec":"4. Preposiciones","w":"van","es":"de; desde","ex":"Het boek van Anna. Van maandag tot vrijdag.","exEs":"El libro de Anna. De lunes a viernes."},{"sec":"4. Preposiciones","w":"vanaf","es":"a partir de; desde","ex":"Vanaf morgen.","exEs":"A partir de mañana."},{"sec":"4. Preposiciones","w":"voor","es":"para; delante de; antes de","ex":"Voor jou. Voor de deur. Voor vijf uur.","exEs":"Para ti. Delante de la puerta. Antes de las cinco."},{"sec":"4. Preposiciones","w":"zonder","es":"sin","ex":"Koffie zonder suiker.","exEs":"Café sin azúcar."},{"sec":"4. Preposiciones","w":"volgens","es":"según","ex":"Volgens mij…","exEs":"En mi opinión…"},{"sec":"4. Preposiciones","w":"ondanks","es":"a pesar de","ex":"Ondanks de regen.","exEs":"A pesar de la lluvia."},{"sec":"4. Preposiciones","w":"vanwege","es":"a causa de","ex":"Vanwege het weer.","exEs":"A causa del tiempo."},{"sec":"4. Preposiciones","w":"behalve","es":"excepto","ex":"Iedereen behalve ik.","exEs":"Todos excepto yo."},{"sec":"4. Preposiciones","w":"rond / rondom","es":"alrededor de; sobre","ex":"Rond de tafel. Rond tien uur.","exEs":"Alrededor de la mesa. Sobre las diez."},{"sec":"6. Demostrativos","w":"dit / dat + zijn","es":"este es / ese es (presentar)","ex":"Dit is mijn broer. Dat zijn mijn ouders.","exEs":"Este es mi hermano. Esos son mis padres."},{"sec":"6. Demostrativos","w":"dit / dat","es":"esto / eso","ex":"Wat is dat? Dat klopt.","exEs":"¿Qué es eso? Es verdad."},{"sec":"6. Demostrativos","w":"zo'n / zulke","es":"un… así, tal(es)","ex":"Zo'n auto wil ik ook. Zulke mensen…","exEs":"Yo también quiero un coche así. Gente así…"},{"sec":"6. Demostrativos","w":"dezelfde / hetzelfde","es":"el mismo, la misma / lo mismo · el mismo / lo mismo","ex":"Dezelfde dag. Hetzelfde huis.","exEs":"El mismo día. La misma casa."},{"sec":"6. Demostrativos","w":"hier / daar","es":"aquí / allí","ex":"Dit boek hier, niet dat daar.","exEs":"Este libro, no ese."},{"sec":"7. Interrogativos","w":"wie","es":"¿quién?","ex":"Wie is dat?","exEs":"¿Quién es?"},{"sec":"7. Interrogativos","w":"wat","es":"¿qué? · qué; lo que","ex":"Wat doe je?","exEs":"¿Qué haces?"},{"sec":"7. Interrogativos","w":"welk / welke","es":"¿cuál?, ¿qué? (+ sust.)","ex":"Welk huis? Welke kleur?","exEs":"¿Qué casa? ¿Qué color?"},{"sec":"7. Interrogativos","w":"wat voor (een)","es":"¿qué tipo de?","ex":"Wat voor auto heb je?","exEs":"¿Qué tipo de coche tienes?"},{"sec":"7. Interrogativos","w":"hoe","es":"¿cómo?","ex":"Hoe heet je?","exEs":"¿Cómo te llamas?"},{"sec":"7. Interrogativos","w":"hoeveel","es":"¿cuánto/s?","ex":"Hoeveel kost dat?","exEs":"¿Cuánto cuesta?"},{"sec":"7. Interrogativos","w":"hoe laat","es":"¿qué hora? / ¿a qué hora?","ex":"Hoe laat is het? Hoe laat begint het?","exEs":"¿Qué hora es? ¿A qué hora empieza?"},{"sec":"7. Interrogativos","w":"hoe lang / hoe vaak / hoe oud","es":"¿cuánto tiempo? / ¿cada cuánto? / ¿qué edad?","ex":"Hoe oud ben je?","exEs":"¿Cuántos años tienes?"},{"sec":"7. Interrogativos","w":"waar","es":"¿dónde? · dónde; donde","ex":"Waar woon je?","exEs":"¿Dónde vives?"},{"sec":"7. Interrogativos","w":"waar… naartoe / waarheen","es":"¿adónde?","ex":"Waar ga je naartoe?","exEs":"¿Adónde vas?"},{"sec":"7. Interrogativos","w":"waar… vandaan","es":"¿de dónde?","ex":"Waar kom je vandaan?","exEs":"¿De dónde eres?"},{"sec":"7. Interrogativos","w":"wanneer","es":"¿cuándo?","ex":"Wanneer kom je?","exEs":"¿Cuándo vienes?"},{"sec":"7. Interrogativos","w":"waarom","es":"¿por qué?","ex":"Waarom lach je?","exEs":"¿Por qué te ríes?"},{"sec":"7. Interrogativos","w":"van wie","es":"¿de quién?","ex":"Van wie is dit?","exEs":"¿De quién es esto?"},{"sec":"7. Interrogativos","w":"met wie / voor wie","es":"¿con quién? / ¿para quién?","ex":"Met wie ga je?","exEs":"¿Con quién vas?"},{"sec":"7. Interrogativos","w":"waarmee / waarover…","es":"¿con qué? / ¿de qué?…","ex":"Waarover gaat het boek?","exEs":"¿De qué trata el libro?"},{"sec":"8. Relativos","w":"die","note":"Cuándo: Palabras de y plurales","ex":"De man die daar staat. De boeken die ik lees.","exEs":"El hombre que está allí. Los libros que leo.","es":"ese; que (relativo)"},{"sec":"8. Relativos","w":"dat","note":"Cuándo: Palabras het (singular)","ex":"Het huis dat ik koop.","exEs":"La casa que compro.","es":"que; eso; ese"},{"sec":"8. Relativos","w":"prep. + wie","note":"Cuándo: Personas, tras preposición","ex":"De vrouw met wie ik werk.","exEs":"La mujer con la que trabajo."},{"sec":"8. Relativos","w":"waar + prep.","note":"Cuándo: Cosas, tras preposición","ex":"Het huis waarin ik woon. De pen waarmee ik schrijf.","exEs":"La casa en la que vivo. El bolígrafo con el que escribo."},{"sec":"8. Relativos","w":"wat","note":"Cuándo: Lo que; tras alles, iets, niets, superlativos","ex":"Alles wat ik weet. Het mooiste wat ik ken.","exEs":"Todo lo que sé. Lo más bonito que conozco."},{"sec":"8. Relativos","w":"waar","note":"Cuándo: Donde","ex":"De stad waar ik woon.","exEs":"La ciudad donde vivo."},{"sec":"8. Relativos","w":"wie","note":"Cuándo: Quien (sin antecedente)","ex":"Wie dat zegt, liegt.","exEs":"Quien dice eso miente."},{"sec":"8. Relativos","w":"van wie / wiens / wier","note":"Cuándo: Cuyo (wiens / wier: formal)","ex":"De man van wie de auto rood is.","exEs":"El hombre cuyo coche es rojo."},{"sec":"9. Conjunciones y orden de la frase","w":"en","es":"y","ex":"Ik kook en jij wast af.","exEs":"Yo cocino y tú friegas."},{"sec":"9. Conjunciones y orden de la frase","w":"maar","es":"pero; sino · pero; solo","ex":"Het is duur, maar goed. Niet ik, maar hij.","exEs":"Es caro, pero bueno. No yo, sino él."},{"sec":"9. Conjunciones y orden de la frase","w":"of","es":"o · o; si (indirecto)","ex":"Thee of koffie?","exEs":"¿Té o café?"},{"sec":"9. Conjunciones y orden de la frase","w":"want","es":"porque, pues","ex":"Ik blijf thuis, want het regent.","exEs":"Me quedo en casa, porque llueve."},{"sec":"9. Conjunciones y orden de la frase","w":"dus","es":"así que (también admite inversión)","ex":"Het regent, dus ik blijf thuis.","exEs":"Llueve, así que me quedo en casa."},{"sec":"9. Conjunciones y orden de la frase","w":"daarom","es":"por eso","ex":"Het regent, daarom blijf ik thuis.","exEs":"Llueve, por eso me quedo en casa."},{"sec":"9. Conjunciones y orden de la frase","w":"toch","es":"aun así · aun así; ¿no?","ex":"Het regent, toch ga ik naar buiten.","exEs":"Llueve, aun así salgo."},{"sec":"9. Conjunciones y orden de la frase","w":"dan / daarna","es":"luego, después","ex":"Eerst eet ik, daarna ga ik weg.","exEs":"Primero como, después me voy."},{"sec":"9. Conjunciones y orden de la frase","w":"bovendien","es":"además","ex":"Bovendien is het goedkoop.","exEs":"Además, es barato."},{"sec":"9. Conjunciones y orden de la frase","w":"anders","es":"si no, de lo contrario · si no; distinto","ex":"Schiet op, anders kom je te laat.","exEs":"Date prisa, si no llegarás tarde."},{"sec":"9. Conjunciones y orden de la frase","w":"toen","es":"entonces (pasado) · cuando (pasado); entonces","ex":"Toen ging hij weg.","exEs":"Entonces se fue."},{"sec":"9. Conjunciones y orden de la frase","w":"echter","es":"sin embargo (escrito)","ex":"Het is echter niet zo makkelijk.","exEs":"Sin embargo, no es tan fácil."},{"sec":"9. Conjunciones y orden de la frase","w":"trouwens","es":"por cierto; además","ex":"Trouwens, heb je tijd?","exEs":"Por cierto, ¿tienes tiempo?"},{"sec":"9. Conjunciones y orden de la frase","w":"dat","es":"que","ex":"Ik denk dat hij gelijk heeft.","exEs":"Creo que tiene razón."},{"sec":"9. Conjunciones y orden de la frase","w":"omdat","es":"porque","ex":"Ik blijf thuis omdat het regent.","exEs":"Me quedo en casa porque llueve."},{"sec":"9. Conjunciones y orden de la frase","w":"doordat","es":"debido a que (causa no intencional)","ex":"Doordat de trein laat was, …","exEs":"Como el tren llegó tarde…"},{"sec":"9. Conjunciones y orden de la frase","w":"aangezien","es":"ya que","ex":"Aangezien je hier bent, …","exEs":"Ya que estás aquí…"},{"sec":"9. Conjunciones y orden de la frase","w":"als","es":"si; cuando (presente, futuro, repetido) · si; cuando; como","ex":"Als je wilt, kom ik.","exEs":"Si quieres, voy."},{"sec":"9. Conjunciones y orden de la frase","w":"toen","es":"cuando (una vez en el pasado)","ex":"Toen ik klein was, …","exEs":"Cuando era pequeño…"},{"sec":"9. Conjunciones y orden de la frase","w":"wanneer","es":"cuando","ex":"Wanneer je klaar bent, bel me.","exEs":"Cuando termines, llámame."},{"sec":"9. Conjunciones y orden de la frase","w":"of","es":"si (pregunta indirecta)","ex":"Ik weet niet of hij komt.","exEs":"No sé si viene."},{"sec":"9. Conjunciones y orden de la frase","w":"hoewel","es":"aunque","ex":"Hoewel ik moe ben, werk ik.","exEs":"Aunque estoy cansado, trabajo."},{"sec":"9. Conjunciones y orden de la frase","w":"terwijl","es":"mientras; mientras que","ex":"Terwijl ik kook, luister ik muziek.","exEs":"Mientras cocino, escucho música."},{"sec":"9. Conjunciones y orden de la frase","w":"zodat","es":"de modo que; para que","ex":"Ik praat langzaam, zodat je me begrijpt.","exEs":"Hablo despacio para que me entiendas."},{"sec":"9. Conjunciones y orden de la frase","w":"om… te + infinitivo","es":"para + infinitivo","ex":"Ik leer Nederlands om in Amsterdam te werken.","exEs":"Aprendo neerlandés para trabajar en Ámsterdam."},{"sec":"9. Conjunciones y orden de la frase","w":"voordat","es":"antes de (que) · antes de que","ex":"Voordat ik ga, eet ik.","exEs":"Antes de irme, como."},{"sec":"9. Conjunciones y orden de la frase","w":"nadat","es":"después de (que) · después de que","ex":"Nadat ik gegeten heb, ga ik.","exEs":"Después de comer, me voy."},{"sec":"9. Conjunciones y orden de la frase","w":"totdat / tot","es":"hasta que","ex":"Ik wacht totdat je komt.","exEs":"Espero hasta que vengas."},{"sec":"9. Conjunciones y orden de la frase","w":"sinds","es":"desde que","ex":"Sinds ik hier woon, …","exEs":"Desde que vivo aquí…"},{"sec":"9. Conjunciones y orden de la frase","w":"zodra","es":"en cuanto","ex":"Zodra ik kan, bel ik je.","exEs":"En cuanto pueda, te llamo."},{"sec":"9. Conjunciones y orden de la frase","w":"zolang","es":"mientras (duración)","ex":"Zolang je hier bent, …","exEs":"Mientras estés aquí…"},{"sec":"9. Conjunciones y orden de la frase","w":"tenzij","es":"a menos que","ex":"Ik kom, tenzij het regent.","exEs":"Voy, a menos que llueva."},{"sec":"9. Conjunciones y orden de la frase","w":"alsof","es":"como si","ex":"Hij doet alsof hij alles weet.","exEs":"Hace como si lo supiera todo."},{"sec":"9. Conjunciones y orden de la frase","w":"zoals","es":"como (modo)","ex":"Zoals je weet, …","exEs":"Como sabes…"},{"sec":"9. Conjunciones y orden de la frase","w":"nu","es":"ahora que","ex":"Nu je hier bent, …","exEs":"Ahora que estás aquí…"},{"sec":"9. Conjunciones y orden de la frase","w":"zonder te / zonder dat","es":"sin / sin que","ex":"Hij ging weg zonder iets te zeggen.","exEs":"Se fue sin decir nada."},{"sec":"9. Conjunciones y orden de la frase","w":"door te + infinitivo","es":"haciendo, al + inf.","ex":"Je leert door te oefenen.","exEs":"Se aprende practicando."},{"sec":"9. Conjunciones y orden de la frase","w":"hoe… hoe","es":"cuanto más… más","ex":"Hoe meer ik leer, hoe beter ik spreek.","exEs":"Cuanto más estudio, mejor hablo."},{"sec":"9. Conjunciones y orden de la frase","w":"zowel… als","es":"tanto… como","ex":"Zowel ik als mijn broer."},{"sec":"9. Conjunciones y orden de la frase","w":"of… of","es":"o… o","ex":"Of vandaag of morgen."},{"sec":"9. Conjunciones y orden de la frase","w":"noch… noch","es":"ni… ni","ex":"Noch wijn noch bier."},{"sec":"9. Conjunciones y orden de la frase","w":"niet alleen… maar ook","es":"no solo… sino también","ex":"Niet alleen mooi, maar ook goedkoop."},{"sec":"9. Conjunciones y orden de la frase","w":"enerzijds… anderzijds","es":"por un lado… por otro","ex":"Enerzijds wil ik, anderzijds niet."},{"sec":"10. Indefinidos y cuantificadores","w":"alle","es":"todos/as","ex":"Alle kinderen.","exEs":"Todos los niños."},{"sec":"10. Indefinidos y cuantificadores","w":"alles","es":"todo","ex":"Alles is goed.","exEs":"Todo está bien."},{"sec":"10. Indefinidos y cuantificadores","w":"al","es":"todo (+ artículo) · ya; todo","ex":"Al het geld. Al mijn vrienden.","exEs":"Todo el dinero. Todos mis amigos."},{"sec":"10. Indefinidos y cuantificadores","w":"iedereen","es":"todo el mundo","ex":"Iedereen weet het.","exEs":"Todo el mundo lo sabe."},{"sec":"10. Indefinidos y cuantificadores","w":"ieder(e) / elk(e)","es":"cada","ex":"Elke dag. Ieder jaar.","exEs":"Cada día. Cada año."},{"sec":"10. Indefinidos y cuantificadores","w":"heel","es":"entero; muy","ex":"De hele dag. Heel mooi.","exEs":"Todo el día. Muy bonito."},{"sec":"10. Indefinidos y cuantificadores","w":"beide / allebei","es":"ambos, los dos","ex":"Ze komen allebei.","exEs":"Vienen los dos."},{"sec":"10. Indefinidos y cuantificadores","w":"sommige / enkele","es":"algunos","ex":"Sommige mensen.","exEs":"Algunas personas."},{"sec":"10. Indefinidos y cuantificadores","w":"een paar","es":"unos cuantos","ex":"Een paar dagen.","exEs":"Unos días."},{"sec":"10. Indefinidos y cuantificadores","w":"een beetje","es":"un poco","ex":"Een beetje suiker.","exEs":"Un poco de azúcar."},{"sec":"10. Indefinidos y cuantificadores","w":"iets","es":"algo","ex":"Wil je iets drinken?","exEs":"¿Quieres beber algo?"},{"sec":"10. Indefinidos y cuantificadores","w":"niets / niks","es":"nada","ex":"Ik zie niets.","exEs":"No veo nada."},{"sec":"10. Indefinidos y cuantificadores","w":"iemand","es":"alguien","ex":"Is daar iemand?","exEs":"¿Hay alguien?"},{"sec":"10. Indefinidos y cuantificadores","w":"niemand","es":"nadie","ex":"Niemand weet het.","exEs":"Nadie lo sabe."},{"sec":"10. Indefinidos y cuantificadores","w":"veel","es":"mucho/s","ex":"Veel tijd. Veel mensen.","exEs":"Mucho tiempo. Mucha gente."},{"sec":"10. Indefinidos y cuantificadores","w":"weinig","es":"poco/s","ex":"Weinig geld.","exEs":"Poco dinero."},{"sec":"10. Indefinidos y cuantificadores","w":"meer / minder","es":"más / menos","ex":"Meer water.","exEs":"Más agua."},{"sec":"10. Indefinidos y cuantificadores","w":"genoeg","es":"suficiente","ex":"Ik heb genoeg tijd.","exEs":"Tengo tiempo suficiente."},{"sec":"10. Indefinidos y cuantificadores","w":"te / te veel","es":"demasiado","ex":"Te duur. Te veel werk.","exEs":"Demasiado caro. Demasiado trabajo."},{"sec":"10. Indefinidos y cuantificadores","w":"erg / heel / zeer","es":"muy","ex":"Erg leuk. Zeer belangrijk.","exEs":"Muy divertido. Muy importante."},{"sec":"10. Indefinidos y cuantificadores","w":"nogal / vrij","es":"bastante","ex":"Nogal koud.","exEs":"Bastante frío."},{"sec":"10. Indefinidos y cuantificadores","w":"ander(e)","es":"otro","ex":"Een andere dag. De anderen.","exEs":"Otro día. Los demás."},{"sec":"10. Indefinidos y cuantificadores","w":"ergens / nergens / overal","es":"en algún / ningún / todo sitio","ex":"Ik heb het ergens gezien.","exEs":"Lo he visto en algún sitio."},{"sec":"10. Indefinidos y cuantificadores","w":"ooit / nooit","es":"alguna vez / nunca","ex":"Ben je ooit in Gent geweest?","exEs":"¿Has estado alguna vez en Gante?"},{"sec":"11. La negación","w":"nee","es":"no (respuesta)","ex":"Nee, dank je.","exEs":"No, gracias."},{"sec":"11. La negación","w":"nooit","es":"nunca","ex":"Ik drink nooit koffie.","exEs":"Nunca tomo café."},{"sec":"11. La negación","w":"niet meer","es":"ya no","ex":"Ik woon hier niet meer.","exEs":"Ya no vivo aquí."},{"sec":"11. La negación","w":"geen… meer","es":"ya no (con sustantivo)","ex":"Ik heb geen geld meer.","exEs":"Ya no tengo dinero."},{"sec":"11. La negación","w":"nog niet","es":"todavía no","ex":"Hij is er nog niet.","exEs":"Todavía no ha llegado."},{"sec":"11. La negación","w":"nog nooit","es":"nunca (hasta ahora)","ex":"Ik ben nog nooit in Gent geweest.","exEs":"Nunca he estado en Gante."},{"sec":"11. La negación","w":"niets / niks","es":"nada","ex":"Ik weet niets.","exEs":"No sé nada."},{"sec":"11. La negación","w":"niemand","es":"nadie","ex":"Ik ken niemand.","exEs":"No conozco a nadie."},{"sec":"11. La negación","w":"nergens","es":"en ninguna parte","ex":"Ik vind het nergens.","exEs":"No lo encuentro en ninguna parte."},{"sec":"11. La negación","w":"helemaal niet","es":"en absoluto","ex":"Dat is helemaal niet slecht.","exEs":"No está nada mal."},{"sec":"11. La negación","w":"ook niet","es":"tampoco","ex":"Ik ook niet.","exEs":"Yo tampoco."},{"sec":"11. La negación","w":"jawel","es":"sí (contradiciendo una negación) · sí (contradiciendo)","ex":"Heb je geen tijd? — Jawel!","exEs":"¿No tienes tiempo? — ¡Sí!"},{"sec":"11. La negación","w":"wel","es":"sí (contraste con una negación) · sí (contraste); bien","ex":"Ik heb geen auto, maar wel een fiets.","exEs":"No tengo coche, pero sí una bici."},{"sec":"11. La negación","w":"maar / alleen","es":"solo","ex":"Ik heb maar tien euro.","exEs":"Solo tengo diez euros."},{"sec":"11. La negación","w":"pas","es":"no hasta; solo (tiempo, edad) · recién; no hasta","ex":"Hij komt pas om acht uur. Ze is pas tien.","ex