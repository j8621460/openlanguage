{"code":"yo","es":"Yoruba","en":"Yoruba","native":"Yorùbá","tts":"yo-NG","entries":[{"w":"kan","pron":"kã","es":"un, una (lit. «uno»)","ex":"ilé kan","exEs":"una casa","sec":"1. Sin artículos: kan, náà y àwọn"},{"w":"náà","pron":"ná-à","es":"el, la (ya mencionado) · también","ex":"ilé náà","exEs":"la casa (esa de la que hablamos)","sec":"1. Sin artículos: kan, náà y àwọn"},{"w":"àwọn","pron":"à-wɔ̃","es":"los, las (plural, va delante)","ex":"àwọn ilé","exEs":"las casas","sec":"1. Sin artículos: kan, náà y àwọn"},{"w":"àwọn… kan","pron":"à-wɔ̃… kã","es":"unos, algunos","ex":"àwọn ènìyàn kan","exEs":"algunas personas","sec":"1. Sin artículos: kan, náà y àwọn"},{"w":"àwọn… náà","pron":"à-wɔ̃… ná-à","es":"los (ya mencionados)","ex":"àwọn ọmọ náà","exEs":"los niños (esos)","sec":"1. Sin artículos: kan, náà y àwọn"},{"w":"mo · èmi","pron":"mo · è-mi","es":"yo","sec":"2. Pronombres personales y posesivos","note":"Forma corta (pegada al verbo) · forma enfática (sola o para resaltar)","ex":"Mo wá láti Sípéènì.","exEs":"Soy de España."},{"w":"o · ìwọ","pron":"o · ì-wɔ","es":"tú","sec":"2. Pronombres personales y posesivos","note":"Forma corta (pegada al verbo) · forma enfática (sola o para resaltar)","ex":"O ń sọ Yorùbá.","exEs":"Hablas yoruba."},{"w":"ó · òun","pron":"ó · ò-ũ","es":"él, ella, ello · él / ella","sec":"2. Pronombres personales y posesivos","note":"Forma corta (pegada al verbo) · forma enfática (sola o para resaltar)","ex":"Ó wà nílé.","exEs":"Está en casa."},{"w":"a · àwa","pron":"a · à-wa","es":"nosotros/as","sec":"2. Pronombres personales y posesivos","note":"Forma corta (pegada al verbo) · forma enfática (sola o para resaltar)","ex":"A jẹ́ ọ̀rẹ́.","exEs":"Somos amigos."},{"w":"ẹ · ẹ̀yin","pron":"ɛ · ɛ̀-yĩ","es":"vosotros; usted (respeto)","sec":"2. Pronombres personales y posesivos","note":"Forma corta (pegada al verbo) · forma enfática (sola o para resaltar)","ex":"Ẹ káàbọ̀.","exEs":"Bienvenido(s)."},{"w":"wọ́n · àwọn","pron":"wɔ̃́ · à-wɔ̃","es":"ellos; él / ella (respeto)","sec":"2. Pronombres personales y posesivos","note":"Forma corta (pegada al verbo) · forma enfática (sola o para resaltar)","ex":"Wọ́n wà ní Èkó.","exEs":"Están en Lagos."},{"w":"mi","pron":"mi","es":"objeto de «yo» (me, te, lo…)","ex":"Ó rí mi.","exEs":"Me vio.","sec":"2. Pronombres personales y posesivos"},{"w":"mi","pron":"mi","es":"posesivo de «yo» (mi, tu, su…)","ex":"ilé mi","exEs":"mi casa","sec":"2. Pronombres personales y posesivos"},{"w":"ọ","pron":"ɔ","es":"objeto de «tú» (me, te, lo…)","ex":"Mo rí ọ.","exEs":"Te vi.","sec":"2. Pronombres personales y posesivos"},{"w":"rẹ","pron":"rɛ","es":"posesivo de «tú» (mi, tu, su…)","ex":"ilé rẹ","exEs":"tu casa","sec":"2. Pronombres personales y posesivos"},{"w":"rẹ̀","pron":"rɛ̀","es":"posesivo de «él, ella» (mi, tu, su…)","ex":"ilé rẹ̀","exEs":"su casa","sec":"2. Pronombres personales y posesivos"},{"w":"wa","pron":"wa","es":"objeto de «nosotros» (me, te, lo…)","ex":"Ó rí wa.","exEs":"Nos vio.","sec":"2. Pronombres personales y posesivos"},{"w":"wa","pron":"wa","es":"posesivo de «nosotros» (mi, tu, su…)","ex":"ilé wa","exEs":"nuestra casa","sec":"2. Pronombres personales y posesivos"},{"w":"yín","pron":"yĩ́","es":"objeto de «vosotros, usted» (me, te, lo…)","ex":"Mo rí yín.","exEs":"Os / lo vi.","sec":"2. Pronombres personales y posesivos"},{"w":"yín","pron":"yĩ́","es":"posesivo de «vosotros, usted» (mi, tu, su…)","ex":"ilé yín","exEs":"vuestra casa","sec":"2. Pronombres personales y posesivos"},{"w":"wọn","pron":"wɔ̃","es":"objeto de «ellos» (me, te, lo…)","ex":"Mo rí wọn.","exEs":"Los vi.","sec":"2. Pronombres personales y posesivos"},{"w":"wọn","pron":"wɔ̃","es":"posesivo de «ellos» (mi, tu, su…)","ex":"ilé wọn","exEs":"su casa (de ellos)","sec":"2. Pronombres personales y posesivos"},{"w":"ní","pron":"ní","es":"en (lugar, tiempo) · tener","ex":"Mo ń gbé ní Èkó.","exEs":"Vivo en Lagos.","sec":"3. Preposiciones"},{"w":"sí","pron":"sí","es":"a, hacia","ex":"Mo ń lọ sí ọjà.","exEs":"Voy al mercado.","sec":"3. Preposiciones"},{"w":"láti","pron":"lá-ti","es":"de, desde","ex":"Mo wá láti Mẹ́síkò.","exEs":"Soy de México.","sec":"3. Preposiciones"},{"w":"pẹ̀lú","pron":"kpɛ̀-lú","es":"con","ex":"Mo ń gbé pẹ̀lú àbúrò mi.","exEs":"Vivo con mi hermano menor.","sec":"3. Preposiciones"},{"w":"fún","pron":"fṹ","es":"para, a (destinatario)","ex":"Èyí wà fún ọ.","exEs":"Esto es para ti.","sec":"3. Preposiciones"},{"w":"nípa","pron":"ní-kpa","es":"sobre, acerca de · sobre (tema)","ex":"A ń sọ̀rọ̀ nípa iṣẹ́.","exEs":"Hablamos del trabajo.","sec":"3. Preposiciones"},{"w":"bí / bíi","pron":"bí / bí-i","es":"como","ex":"Ó ń ṣiṣẹ́ bí olùkọ́.","exEs":"Trabaja como profesor.","sec":"3. Preposiciones"},{"w":"títí di","pron":"tí-tí di","es":"hasta","ex":"títí di ọ̀la","exEs":"hasta mañana","sec":"3. Preposiciones"},{"w":"láìsí","pron":"lá-ì-sí","es":"sin","ex":"kọfí láìsí ṣúgà","exEs":"café sin azúcar","sec":"3. Preposiciones"},{"w":"nítorí","pron":"ní-to-rí","es":"a causa de","ex":"nítorí òjò","exEs":"a causa de la lluvia","sec":"3. Preposiciones"},{"w":"dípò","pron":"dí-kpò","es":"en lugar de","ex":"tíì dípò kọfí","exEs":"té en lugar de café","sec":"3. Preposiciones"},{"w":"àfi","pron":"à-fi","es":"excepto","ex":"gbogbo wa àfi èmi","exEs":"todos excepto yo","sec":"3. Preposiciones"},{"w":"ṣáájú","pron":"shá-á-dyú","es":"antes de","ex":"ṣáájú oúnjẹ","exEs":"antes de la comida","sec":"3. Preposiciones"},{"w":"lẹ́yìn","pron":"lɛ́-yĩ","es":"después de; detrás de","ex":"lẹ́yìn iṣẹ́ · lẹ́yìn ilé","exEs":"después del trabajo · detrás de la casa","sec":"3. Preposiciones"},{"w":"lórí","pron":"ló-rí","es":"sobre, encima de","ex":"Ìwé wà lórí tábìlì.","exEs":"El libro está sobre la mesa.","sec":"3. Preposiciones"},{"w":"lábẹ́","pron":"lá-bɛ́","es":"debajo de","ex":"lábẹ́ ibùsùn","exEs":"debajo de la cama","sec":"3. Preposiciones"},{"w":"nínú","pron":"ní-nú","es":"dentro de","ex":"nínú ilé","exEs":"dentro de la casa","sec":"3. Preposiciones"},{"w":"níta","pron":"ní-ta","es":"fuera de","ex":"níta ìlú","exEs":"fuera de la ciudad","sec":"3. Preposiciones"},{"w":"níwájú","pron":"ní-wá-dyú","es":"delante de","ex":"níwájú ilé","exEs":"delante de la casa","sec":"3. Preposiciones"},{"w":"lẹ́gbẹ̀ẹ́","pron":"lɛ́-gbɛ̀-ɛ́","es":"al lado de","ex":"lẹ́gbẹ̀ẹ́ mi","exEs":"a mi lado","sec":"3. Preposiciones"},{"w":"láàrin","pron":"lá-à-rĩ","es":"entre","ex":"láàrin èmi àti ìwọ","exEs":"entre tú y yo","sec":"3. Preposiciones"},{"w":"nítòsí","pron":"ní-tò-sí","es":"cerca de","ex":"nítòsí ọjà","exEs":"cerca del mercado","sec":"3. Preposiciones"},{"w":"ní aago mẹ́jọ","pron":"ní a-a-go mɛ́-dyɔ","es":"a las ocho","sec":"3. Preposiciones"},{"w":"Aago mélòó ló lù?","pron":"a-a-go mé-lò-ó ló lù","es":"¿Qué hora es?","sec":"3. Preposiciones"},{"w":"ní ọjọ́ Ajé","pron":"ní ɔ-dyɔ́ a-dyé","es":"el lunes","sec":"3. Preposiciones"},{"w":"ní ìgbà òjò","pron":"ní ì-gbà ò-dyò","es":"en la estación de lluvias","sec":"3. Preposiciones"},{"w":"ní ọdún méjì sẹ́yìn","pron":"ní ɔ-dṹ mé-dyì sɛ́-yĩ","es":"hace dos años","sec":"3. Preposiciones"},{"w":"Mo ti ń gbé ibí fún ọdún méjì.","pron":"mo ti ń gbé i-bí fṹ ɔ-dṹ mé-dyì","es":"Llevo dos años viviendo aquí.","sec":"3. Preposiciones"},{"w":"lẹ́yìn wákàtí kan","pron":"lɛ́-yĩ wá-kà-tí kã","es":"dentro de una hora","sec":"3. Preposiciones"},{"w":"láti aago mẹ́sàn-án sí aago márùn-ún","pron":"lá-ti a-a-go mɛ́-sà-ã́ sí a-a-go má-rù-ṹ","es":"de nueve a cinco","sec":"3. Preposiciones"},{"w":"láàárọ̀ · ní ọ̀sán · lálẹ́","pron":"lá-à-á-rɔ̀ · ní ɔ̀-sã́ · lá-lɛ́","es":"por la mañana · por la tarde · por la noche","sec":"3. Preposiciones"},{"w":"ní","pron":"ní","es":"tener","ex":"Mo ní ẹ̀gbọ́n kan.","exEs":"Tengo un hermano mayor.","sec":"3. Preposiciones"},{"w":"ò ní","pron":"ò ní","es":"no tener","ex":"Mi ò ní àkókò.","exEs":"No tengo tiempo.","sec":"3. Preposiciones"},{"w":"ní… tẹ́lẹ̀","pron":"ní… tɛ́-lɛ̀","es":"tenía (antes)","ex":"Mo ní ajá kan tẹ́lẹ̀.","exEs":"Antes tenía un perro.","sec":"3. Preposiciones"},{"w":"ní láti","pron":"ní lá-ti","es":"tener que","ex":"Mo ní láti lọ.","exEs":"Tengo que irme.","sec":"3. Preposiciones"},{"es":"tengo hambre","w":"Ebi ń pa mí.","pron":"e-bi ń kpa mí","sec":"3. Preposiciones"},{"es":"tengo sed","w":"Òùngbẹ ń gbẹ mí.","pron":"ò-ù-gbɛ ń gbɛ mí","sec":"3. Preposiciones"},{"es":"tengo miedo","w":"Ẹ\u0000rù ń bà mí.","pron":"ɛ̀-rù ń bà mí","sec":"3. Preposiciones"},{"es":"tengo frío","w":"Òtútù ń mú mi.","pron":"ò-tú-tù ń mú mi","sec":"3. Preposiciones"},{"es":"tengo sueño","w":"Oorun ń kùn mí.","pron":"o-o-rũ ń kù mí","sec":"3. Preposiciones"},{"es":"tengo 20 años","w":"Ọmọ ọdún ogún ni mí.","pron":"ɔ-mɔ ɔ-dṹ o-gṹ ni mí","sec":"3. Preposiciones"},{"es":"no lo entiendo","w":"Kò yé mi.","pron":"kò yé mi","sec":"3. Preposiciones"},{"w":"yìí","pron":"yì-í","es":"este, esta (tras nombre)","ex":"ilé yìí","exEs":"esta casa","sec":"4. Demostrativos"},{"w":"yẹn","pron":"yɛ̃","es":"ese, aquel (tras nombre)","ex":"ìwé yẹn","exEs":"ese libro","sec":"4. Demostrativos"},{"w":"náà","pron":"ná-à","es":"ese (ya mencionado)","ex":"ọkùnrin náà","exEs":"ese hombre, el hombre","sec":"4. Demostrativos"},{"w":"àwọn… wọ̀nyí","pron":"à-wɔ̃… wɔ̃̀-yí","es":"estos, estas","ex":"àwọn ilé wọ̀nyí","exEs":"estas casas","sec":"4. Demostrativos"},{"w":"àwọn… wọ̀nyẹn","pron":"à-wɔ̃… wɔ̃̀-yɛ̃","es":"esos, esas","ex":"àwọn ìwé wọ̀nyẹn","exEs":"esos libros","sec":"4. Demostrativos"},{"w":"èyí","pron":"è-yí","es":"esto, este (solo)","ex":"Èyí ni ẹ̀gbọ́n mi.","exEs":"Este es mi hermano mayor.","sec":"4. Demostrativos"},{"w":"ìyẹn","pron":"ì-yɛ̃","es":"eso, ese (solo)","ex":"Ìyẹn dára.","exEs":"Eso está bien.","sec":"4. Demostrativos"},{"w":"níbí","pron":"ní-bí","es":"aquí","ex":"Mo wà níbí.","exEs":"Estoy aquí.","sec":"4. Demostrativos"},{"w":"níbẹ̀","pron":"ní-bɛ̀","es":"ahí, allí","ex":"Ó wà níbẹ̀.","exEs":"Está allí.","sec":"4. Demostrativos"},{"w":"lọ́hùn-ún","pron":"lɔ́-hù-ṹ","es":"allá (lejos)","ex":"Ilé wa wà lọ́hùn-ún.","exEs":"Nuestra casa está allá.","sec":"4. Demostrativos"},{"w":"… wà","pron":"wà","es":"hay, existe","ex":"Ìṣòro kan wà.","exEs":"Hay un problema.","sec":"4. Demostrativos"},{"w":"kí ni","pron":"kí ni","es":"¿qué?","ex":"Kí ni orúkọ rẹ?","exEs":"¿Cómo te llamas? (lit. ¿qué es tu nombre?)","sec":"5. Interrogativos"},{"w":"ta ni","pron":"ta ni","es":"¿quién?","ex":"Ta ni ìyẹn?","exEs":"¿Quién es ese?","sec":"5. Interrogativos"},{"w":"níbo / ibo ni","pron":"ní-bo / i-bo ni","es":"¿dónde?","ex":"Níbo ni ilé ìgbọ̀nsẹ̀ wà?","exEs":"¿Dónde está el baño?","sec":"5. Interrogativos"},{"w":"… dà?","pron":"dà","es":"¿dónde está…?","ex":"Ìwé mi dà?","exEs":"¿Dónde está mi libro?","sec":"5. Interrogativos"},{"w":"ibo ni… ti","pron":"i-bo ni… ti","es":"¿de dónde?","ex":"Ibo lo ti wá?","exEs":"¿De dónde eres?","sec":"5. Interrogativos"},{"w":"ibo ni… ń lọ","pron":"i-bo ni… ń lɔ","es":"¿adónde?","ex":"Ibo lò ń lọ?","exEs":"¿Adónde vas?","sec":"5. Interrogativos"},{"w":"ìgbà wo / nígbà wo","pron":"ì-gbà wo / ní-gbà wo","es":"¿cuándo?","ex":"Nígbà wo lo máa dé?","exEs":"¿Cuándo llegas?","sec":"5. Interrogativos"},{"w":"báwo","pron":"bá-wo","es":"¿cómo?","ex":"Báwo ni?","exEs":"¿Qué tal?","sec":"5. Interrogativos"},{"w":"kí ló dé","pron":"kí ló dé","es":"¿por qué?, ¿qué pasa?","ex":"Kí ló dé tí o fi ń rẹ́rìn-ín?","exEs":"¿Por qué te ríes?","sec":"5. Interrogativos"},{"w":"nítorí kí ni","pron":"ní-to-rí kí ni","es":"¿por qué? (formal)","ex":"Nítorí kí ni?","exEs":"¿Por qué?","sec":"5. Interrogativos"},{"w":"mélòó","pron":"mé-lò-ó","es":"¿cuántos?","ex":"Ọmọ mélòó lo ní?","exEs":"¿Cuántos hijos tienes?","sec":"5. Interrogativos"},{"w":"èló","pron":"è-ló","es":"¿cuánto cuesta?","ex":"Èló ni èyí?","exEs":"¿Cuánto cuesta esto?","sec":"5. Interrogativos"},{"w":"èwo","pron":"è-wo","es":"¿cuál?","ex":"Èwo lo fẹ́?","exEs":"¿Cuál quieres?","sec":"5. Interrogativos"},{"w":"ṣé","pron":"shé","es":"(pregunta de sí / no)","ex":"Ṣé o ń sọ Yorùbá?","exEs":"¿Hablas yoruba?","sec":"5. Interrogativos"},{"w":"ti ta ni","pron":"ti ta ni","es":"¿de quién?","ex":"Ti ta ni èyí?","exEs":"¿De quién es esto?","sec":"5. Interrogativos"},{"w":"pẹ̀lú ta ni","pron":"kpɛ̀-lú ta ni","es":"¿con quién?","ex":"Pẹ̀lú ta lo ń gbé?","exEs":"¿Con quién vives?","sec":"5. Interrogativos"},{"w":"… ńkọ́?","pron":"ń-kɔ́","es":"¿y…?","ex":"Ìwọ ńkọ́?","exEs":"¿Y tú?","sec":"5. Interrogativos"},{"w":"tí","pron":"tí","es":"que, el cual · que (relativo)","ex":"ìwé tí mo kà","exEs":"el libro que leí","sec":"6. Relativos"},{"w":"tí ó / tó","pron":"tí ó / tó","es":"que (sujeto 3.ª persona)","ex":"ọkùnrin tó ń ṣiṣẹ́ níbí","exEs":"el hombre que trabaja aquí","sec":"6. Relativos"},{"w":"ẹni tí","pron":"ɛ-ni tí","es":"quien, la persona que","ex":"ẹni tí ó kẹ́kọ̀ọ́","exEs":"quien estudia","sec":"6. Relativos"},{"w":"ohun tí","pron":"o-hũ tí","es":"lo que","ex":"Ṣe ohun tí o fẹ́.","exEs":"Haz lo que quieras.","sec":"6. Relativos"},{"w":"ibi tí","pron":"i-bi tí","es":"donde","ex":"ibi tí mo ń gbé","exEs":"el lugar donde vivo","sec":"6. Relativos"},{"w":"ìgbà tí","pron":"ì-gbà tí","es":"(el momento en) que","ex":"ìgbà tí mo dé","exEs":"cuando llegué","sec":"6. Relativos"},{"w":"bí… ṣe","pron":"bí… she","es":"cómo, la manera en que","ex":"Mo mọ bí ó ṣe ń ṣe é.","exEs":"Sé cómo se hace.","sec":"6. Relativos"},{"w":"àti","pron":"à-ti","es":"y (entre nombres) · y (nombres)","ex":"èmi àti ìwọ","exEs":"tú y yo","sec":"7. Conjunciones"},{"w":"sì","pron":"sì","es":"y (entre frases) · y (frases)","ex":"Mo jẹun, mo sì sùn.","exEs":"Comí y dormí.","sec":"7. Conjunciones"},{"w":"tàbí","pron":"tà-bí","es":"o","ex":"tíì tàbí kọfí","exEs":"té o café","sec":"7. Conjunciones"},{"w":"ṣùgbọ́n / àmọ́","pron":"shù-gbɔ̃́ / à-mɔ́","es":"pero","ex":"Ó tutù, ṣùgbọ́n ó dára.","exEs":"Hace frío, pero está bien.","sec":"7. Conjunciones"},{"w":"yálà… tàbí","pron":"yá-là… tà-bí","es":"o… o","ex":"yálà lónìí tàbí lọ́la","exEs":"o hoy o mañana","sec":"7. Conjunciones"},{"w":"kì í ṣe… bí kò ṣe","pron":"kì í she… bí kò she","es":"no… sino","ex":"Kì í ṣe Adé, bí kò ṣe Túndé.","exEs":"No es Adé, sino Túndé.","sec":"7. Conjunciones"},{"w":"pé","pron":"kpé","es":"que · que (conjunción)","ex":"Mo mọ̀ pé o wà níbí.","exEs":"Sé que estás aquí.","sec":"7. Conjunciones"},{"w":"kí","pron":"kí","es":"que (+ deseo, orden)","ex":"Mo fẹ́ kí o wá.","exEs":"Quiero que vengas.","sec":"7. Conjunciones"},{"w":"nítorí pé / torí pé","pron":"ní-to-rí kpé / to-rí kpé","es":"porque","ex":"nítorí pé ara mi kò yá","exEs":"porque estoy enfermo","sec":"7. Conjunciones"},{"w":"nítorí náà","pron":"ní-to-rí ná-à","es":"por eso","ex":"Nítorí náà, mo dúró sílé.","exEs":"Por eso me quedé en casa.","sec":"7. Conjunciones"},{"w":"bí… bá","pron":"bí… bá","es":"si (condición)","ex":"Bí o bá fẹ́, màá bá ọ lọ.","exEs":"Si quieres, voy contigo.","sec":"7. Conjunciones"},{"w":"tí… bá","pron":"tí… bá","es":"si, cuando (futuro)","ex":"Tí mo bá dé, màá pè ọ́.","exEs":"Cuando llegue, te llamo.","sec":"7. Conjunciones"},{"w":"nígbà tí","pron":"ní-gbà tí","es":"cuando","ex":"Nígbà tí mo wà ní kékeré…","exEs":"Cuando era pequeño…","sec":"7. Conjunciones"},{"w":"bí… ṣe ń","pron":"bí… she ń","es":"mientras","ex":"Bí mo ṣe ń se oúnjẹ, mo ń gbọ́ orin.","exEs":"Mientras cocino, escucho música.","sec":"7. Conjunciones"},{"w":"kí… tó","pron":"kí… tó","es":"antes de que","ex":"kí o tó lọ","exEs":"antes de que te vayas","sec":"7. Conjunciones"},{"w":"lẹ́yìn tí","pron":"lɛ́-yĩ tí","es":"después de que","ex":"lẹ́yìn tí a jẹun","exEs":"después de comer","sec":"7. Conjunciones"},{"w":"títí","pron":"tí-tí","es":"hasta que","ex":"Dúró títí màá fi dé.","exEs":"Espera hasta que llegue.","sec":"7. Conjunciones"},{"w":"kí… lè","pron":"kí… lè","es":"para (que) · para que","ex":"Mo ń kẹ́kọ̀ọ́ kí n lè yege.","exEs":"Estudio para aprobar.","sec":"7. Conjunciones"},{"w":"bíi pé","pron":"bí-i kpé","es":"como si","ex":"bíi pé ó mọ gbogbo nǹkan","exEs":"como si lo supiera todo","sec":"7. Conjunciones"},{"w":"bó tilẹ̀ jẹ́ pé","pron":"bó ti-lɛ̀ dyɛ́ kpé","es":"aunque","ex":"bó tilẹ̀ jẹ́ pé ó rẹ̀ mí","exEs":"aunque estoy cansado","sec":"7. Conjunciones"},{"w":"b