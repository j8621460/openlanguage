{"code":"fr","es":"Francés","en":"French","native":"Français","tts":"fr-FR","entries":[{"sec":"1. Artículos","w":"un","es":"un","ex":"un livre, un ami","exEs":"un libro, un amigo"},{"sec":"1. Artículos","w":"une","es":"una","ex":"une maison","exEs":"una casa"},{"sec":"1. Artículos","w":"des","es":"unos, unas (a menudo no se traduce) · unos; de los","ex":"J'ai des amis à Paris.","exEs":"Tengo amigos en París."},{"sec":"1. Artículos","w":"du","note":"Cuándo: Masculino","ex":"Je mange du pain.","exEs":"Como pan.","es":"del; algo de"},{"sec":"1. Artículos","w":"de la","note":"Cuándo: Femenino","ex":"Il a de la chance.","exEs":"Tiene suerte."},{"sec":"1. Artículos","w":"de l'","note":"Cuándo: Ante vocal","ex":"Tu veux de l'eau ?","exEs":"¿Quieres agua?"},{"sec":"1. Artículos","w":"des","note":"Cuándo: Plural","ex":"J'achète des pommes.","exEs":"Compro manzanas."},{"sec":"1. Artículos","w":"la France, le Mexique","es":"Francia, México","note":"Regla: Los países llevan artículo."},{"sec":"1. Artículos","w":"J'aime le café.","es":"Me gusta el café.","note":"Regla: Gustos y generalidades: artículo definido."},{"sec":"1. Artículos","w":"le lundi","es":"los lunes","note":"Regla: Día con artículo = cada semana. «lundi» sin artículo = este lunes."},{"sec":"1. Artículos","w":"le 14 juillet","es":"el 14 de julio","note":"Regla: Fechas: sin «de» entre día y mes."},{"sec":"1. Artículos","w":"Il est médecin.","es":"Es médico.","note":"Regla: Profesiones tras être: sin artículo (como en español)."},{"sec":"2. Preposiciones","w":"à","es":"a, en","ex":"Je vais à Lyon. J'habite à Paris. À 8 heures.","exEs":"Voy a Lyon. Vivo en París. A las 8."},{"sec":"2. Preposiciones","w":"de","es":"de, desde","ex":"Le livre de Marc. Je viens de Madrid.","exEs":"El libro de Marc. Vengo de Madrid."},{"sec":"2. Preposiciones","w":"en","es":"en (países fem., meses, transporte, materia) · en; de eso","ex":"En France. En mai. En train. En bois.","exEs":"En Francia. En mayo. En tren. De madera."},{"sec":"2. Preposiciones","w":"dans","es":"en, dentro de; dentro de (tiempo)","ex":"Dans la boîte. Dans deux jours.","exEs":"En la caja. Dentro de dos días."},{"sec":"2. Preposiciones","w":"chez","es":"a / en casa de; en (profesional)","ex":"Je vais chez Marie. Chez le médecin.","exEs":"Voy a casa de María. Al médico."},{"sec":"2. Preposiciones","w":"pour","es":"para; por (motivo)","ex":"C'est pour toi. Merci pour tout.","exEs":"Es para ti. Gracias por todo."},{"sec":"2. Preposiciones","w":"par","es":"por (medio, agente, lugar)","ex":"Par la fenêtre. Écrit par Hugo. Deux fois par jour.","exEs":"Por la ventana. Escrito por Hugo. Dos veces al día."},{"sec":"2. Preposiciones","w":"avec","es":"con","ex":"Avec mes amis.","exEs":"Con mis amigos."},{"sec":"2. Preposiciones","w":"sans","es":"sin","ex":"Café sans sucre.","exEs":"Café sin azúcar."},{"sec":"2. Preposiciones","w":"sur","es":"sobre, encima de","ex":"Sur la table.","exEs":"Sobre la mesa."},{"sec":"2. Preposiciones","w":"sous","es":"debajo de","ex":"Sous le lit.","exEs":"Debajo de la cama."},{"sec":"2. Preposiciones","w":"entre","es":"entre (dos)","ex":"Entre toi et moi.","exEs":"Entre tú y yo."},{"sec":"2. Preposiciones","w":"parmi","es":"entre (un grupo) · entre (grupo)","ex":"Parmi mes amis.","exEs":"Entre mis amigos."},{"sec":"2. Preposiciones","w":"vers","es":"hacia; sobre (hora)","ex":"Vers la gare. Vers midi.","exEs":"Hacia la estación. Sobre el mediodía."},{"sec":"2. Preposiciones","w":"depuis","es":"desde; desde hace · desde (hace)","ex":"Depuis 2020. Depuis deux ans.","exEs":"Desde 2020. Desde hace dos años."},{"sec":"2. Preposiciones","w":"pendant","es":"durante","ex":"Pendant les vacances.","exEs":"Durante las vacaciones."},{"sec":"2. Preposiciones","w":"avant / après","es":"antes de / después de","ex":"Avant le dîner. Après le cours.","exEs":"Antes de la cena. Después de clase."},{"sec":"2. Preposiciones","w":"contre","es":"contra","ex":"Contre le mur.","exEs":"Contra la pared."},{"sec":"2. Preposiciones","w":"selon / d'après","es":"según","ex":"Selon lui…","exEs":"Según él…"},{"sec":"2. Preposiciones","w":"malgré","es":"a pesar de","ex":"Malgré la pluie.","exEs":"A pesar de la lluvia."},{"sec":"2. Preposiciones","w":"sauf","es":"excepto","ex":"Tous sauf moi.","exEs":"Todos excepto yo."},{"w":"devant","es":"delante de","sec":"2. Preposiciones"},{"w":"derrière","es":"detrás de","sec":"2. Preposiciones"},{"w":"à côté de","es":"al lado de","sec":"2. Preposiciones"},{"w":"en face de","es":"enfrente de","sec":"2. Preposiciones"},{"w":"près de","es":"cerca de","sec":"2. Preposiciones"},{"w":"loin de","es":"lejos de","sec":"2. Preposiciones"},{"w":"au-dessus de","es":"encima de","sec":"2. Preposiciones"},{"w":"au-dessous de","es":"debajo de","sec":"2. Preposiciones"},{"w":"à l'intérieur de","es":"dentro de","sec":"2. Preposiciones"},{"w":"à l'extérieur de","es":"fuera de","sec":"2. Preposiciones"},{"w":"autour de","es":"alrededor de","sec":"2. Preposiciones"},{"w":"au milieu de","es":"en medio de","sec":"2. Preposiciones"},{"w":"jusqu'à","es":"hasta","sec":"2. Preposiciones"},{"w":"à partir de","es":"a partir de","sec":"2. Preposiciones"},{"w":"à cause de","es":"a causa de","sec":"2. Preposiciones"},{"w":"grâce à","es":"gracias a","sec":"2. Preposiciones"},{"w":"au lieu de","es":"en lugar de","sec":"2. Preposiciones"},{"w":"à travers","es":"a través de","sec":"2. Preposiciones"},{"w":"le long de","es":"a lo largo de","sec":"2. Preposiciones"},{"w":"au bout de","es":"al final de; al cabo de","sec":"2. Preposiciones"},{"w":"au sujet de / à propos de","es":"acerca de","sec":"2. Preposiciones"},{"w":"quant à","es":"en cuanto a","sec":"2. Preposiciones"},{"w":"en dehors de","es":"aparte de; fuera de","sec":"2. Preposiciones"},{"w":"à l'aide de","es":"con ayuda de","sec":"2. Preposiciones"},{"sec":"3. Pronombres personales","w":"je (j')","es":"yo","note":"Nota: j' ante vocal: j'aime."},{"sec":"3. Pronombres personales","w":"tu","es":"tú"},{"sec":"3. Pronombres personales","w":"il","es":"él","note":"Nota: También sujeto impersonal: il pleut (llueve), il faut (hace falta)."},{"sec":"3. Pronombres personales","w":"elle","es":"ella"},{"sec":"3. Pronombres personales","w":"on","es":"se; nosotros (coloquial)","note":"Nota: Verbo en 3.ª persona singular. Muy usado: On y va ? = ¿Vamos?"},{"sec":"3. Pronombres personales","w":"nous","es":"nosotros, nosotras","note":"Nota: Más formal o escrito que on."},{"sec":"3. Pronombres personales","w":"vous","es":"vosotros / ustedes / usted","note":"Nota: Sirve para el plural y para el trato de usted."},{"sec":"3. Pronombres personales","w":"ils","es":"ellos (o grupo mixto)"},{"sec":"3. Pronombres personales","w":"elles","es":"ellas"},{"sec":"3. Pronombres personales","w":"moi","es":"yo; mí","ex":"Moi, je reste. Avec moi. C'est moi.","exEs":"Yo me quedo. Conmigo. Soy yo."},{"sec":"3. Pronombres personales","w":"toi","es":"tú; ti","ex":"Et toi ? C'est pour toi.","exEs":"¿Y tú? Es para ti."},{"sec":"3. Pronombres personales","w":"lui","es":"él · él; le","ex":"Je pense à lui.","exEs":"Pienso en él."},{"sec":"3. Pronombres personales","w":"elle","es":"ella","ex":"Chez elle.","exEs":"En su casa (de ella)."},{"sec":"3. Pronombres personales","w":"soi","es":"sí (mismo), uno mismo · sí mismo","ex":"Chacun pour soi.","exEs":"Cada uno a lo suyo."},{"sec":"3. Pronombres personales","w":"nous / vous","es":"nosotros / vosotros, ustedes","ex":"Viens avec nous !","exEs":"¡Ven con nosotros!"},{"sec":"3. Pronombres personales","w":"eux / elles","es":"ellos / ellas","ex":"C'est à eux.","exEs":"Es de ellos."},{"sec":"3. Pronombres personales","w":"me (m')","es":"me","ex":"Il me regarde.","exEs":"Me mira."},{"sec":"3. Pronombres personales","w":"te (t')","es":"te","ex":"Je t'aime.","exEs":"Te quiero."},{"sec":"3. Pronombres personales","w":"le (l')","es":"lo","ex":"Je le connais.","exEs":"Lo conozco."},{"sec":"3. Pronombres personales","w":"la (l')","es":"la","ex":"Je la vois.","exEs":"La veo."},{"sec":"3. Pronombres personales","w":"nous","es":"nos","ex":"Il nous invite.","exEs":"Nos invita."},{"sec":"3. Pronombres personales","w":"vous","es":"os / los, las (ustedes) / lo, la (usted)","ex":"Je vous remercie.","exEs":"Le doy las gracias."},{"sec":"3. Pronombres personales","w":"les","es":"los, las","ex":"Je les achète.","exEs":"Los / las compro."},{"sec":"3. Pronombres personales","w":"me (m')","es":"me (a mí)","ex":"Ça me plaît.","exEs":"Me gusta."},{"sec":"3. Pronombres personales","w":"te (t')","es":"te (a ti)","ex":"Je te téléphone.","exEs":"Te llamo."},{"sec":"3. Pronombres personales","w":"lui","es":"le (a él O a ella)","ex":"Je lui écris.","exEs":"Le escribo."},{"sec":"3. Pronombres personales","w":"nous","es":"nos","ex":"Il nous parle.","exEs":"Nos habla."},{"sec":"3. Pronombres personales","w":"vous","es":"os / les (a ustedes) / le (a usted)","ex":"Je vous explique.","exEs":"Os explico."},{"sec":"3. Pronombres personales","w":"leur","es":"les (a ellos / ellas) · les; su (de ellos)","ex":"Je leur dis la vérité.","exEs":"Les digo la verdad."},{"sec":"3. Pronombres personales","w":"me (m')","es":"me","ex":"Je m'appelle Ana.","exEs":"Me llamo Ana."},{"sec":"3. Pronombres personales","w":"te (t')","es":"te","ex":"Tu te lèves tôt ?","exEs":"¿Te levantas temprano?"},{"sec":"3. Pronombres personales","w":"se (s')","es":"se","ex":"Il s'habille.","exEs":"Se viste."},{"sec":"3. Pronombres personales","w":"nous","es":"nos","ex":"Nous nous voyons demain.","exEs":"Nos vemos mañana."},{"sec":"3. Pronombres personales","w":"vous","es":"os / se","ex":"Vous vous amusez ?","exEs":"¿Os divertís?"},{"sec":"3. Pronombres personales","w":"se (s')","es":"se","ex":"Ils se marient.","exEs":"Se casan."},{"sec":"6. Demostrativos","w":"ce","note":"Cuándo: Masculino ante consonante","ex":"ce livre","exEs":"este / ese libro"},{"sec":"6. Demostrativos","w":"cet","note":"Cuándo: Masculino ante vocal o h muda","ex":"cet homme, cet ami","exEs":"este hombre, este amigo"},{"sec":"6. Demostrativos","w":"cette","note":"Cuándo: Femenino","ex":"cette maison","exEs":"esta / esa casa"},{"sec":"6. Demostrativos","w":"ces","note":"Cuándo: Plural","ex":"ces gens","exEs":"estas / esas personas"},{"sec":"6. Demostrativos","w":"celui / celle","es":"el / la (que, de)","ex":"Celui de Marc. Celle que je veux.","exEs":"El de Marc. La que quiero."},{"sec":"6. Demostrativos","w":"ceux / celles","es":"los / las (que, de)","ex":"Ceux qui travaillent.","exEs":"Los que trabajan."},{"sec":"6. Demostrativos","w":"celui-ci / celui-là","es":"este / ese","ex":"Je préfère celle-là.","exEs":"Prefiero esa."},{"sec":"6. Demostrativos","w":"ce (c')","es":"esto, eso","ex":"C'est vrai. Ce que tu dis.","exEs":"Es verdad. Lo que dices."},{"sec":"6. Demostrativos","w":"ceci / cela","es":"esto / eso (formal)","ex":"Cela ne me plaît pas.","exEs":"Eso no me gusta."},{"sec":"6. Demostrativos","w":"ça","es":"esto, eso (coloquial)","ex":"Ça va ? Ça coûte combien ?","exEs":"¿Qué tal? ¿Cuánto cuesta eso?"},{"sec":"7. Interrogativos","w":"qui","es":"¿quién? · quién; que","ex":"Qui est-ce ?","exEs":"¿Quién es?"},{"sec":"7. Interrogativos","w":"que / qu'est-ce que","es":"¿qué? (objeto)","ex":"Qu'est-ce que tu fais ?","exEs":"¿Qué haces?"},{"sec":"7. Interrogativos","w":"qu'est-ce qui","es":"¿qué? (sujeto)","ex":"Qu'est-ce qui se passe ?","exEs":"¿Qué pasa?"},{"sec":"7. Interrogativos","w":"quoi","es":"¿qué? (coloquial o tras preposición)","ex":"Tu fais quoi ? De quoi tu parles ?","exEs":"¿Qué haces? ¿De qué hablas?"},{"sec":"7. Interrogativos","w":"quel, quelle, quels, quelles","es":"¿qué?, ¿cuál? (+ sustantivo)","ex":"Quel âge as-tu ? Quelle heure est-il ?","exEs":"¿Cuántos años tienes? ¿Qué hora es?"},{"sec":"7. Interrogativos","w":"lequel, laquelle, lesquels, lesquelles","es":"¿cuál?, ¿cuáles?","ex":"Lequel tu préfères ?","exEs":"¿Cuál prefieres?"},{"sec":"7. Interrogativos","w":"combien (de)","es":"¿cuánto?, ¿cuántos?","ex":"Combien ça coûte ? Combien de frères ?","exEs":"¿Cuánto cuesta? ¿Cuántos hermanos?"},{"sec":"7. Interrogativos","w":"où","es":"¿dónde?, ¿adónde? · dónde; donde","ex":"Où est la gare ?","exEs":"¿Dónde está la estación?"},{"sec":"7. Interrogativos","w":"d'où","es":"¿de dónde?","ex":"D'où viens-tu ?","exEs":"¿De dónde vienes?"},{"sec":"7. Interrogativos","w":"quand","es":"¿cuándo? · cuándo; cuando","ex":"Quand pars-tu ?","exEs":"¿Cuándo te vas?"},{"sec":"7. Interrogativos","w":"comment","es":"¿cómo?","ex":"Comment tu t'appelles ?","exEs":"¿Cómo te llamas?"},{"sec":"7. Interrogativos","w":"pourquoi","es":"¿por qué?","ex":"Pourquoi tu ris ?","exEs":"¿Por qué te ríes?"},{"sec":"7. Interrogativos","w":"à quelle heure","es":"¿a qué hora?","ex":"À quelle heure ça ouvre ?","exEs":"¿A qué hora abre?"},{"sec":"7. Interrogativos","w":"à qui / avec qui / pour qui","es":"¿a / con / para quién?","ex":"Avec qui tu sors ?","exEs":"¿Con quién sales?"},{"sec":"7. Interrogativos","w":"est-ce que","es":"(convierte en pregunta)","ex":"Est-ce que tu viens ?","exEs":"¿Vienes?"},{"sec":"8. Relativos","w":"qui","es":"que (sujeto del verbo)","ex":"La fille qui parle. Le livre qui est là.","exEs":"La chica que habla. El libro que está ahí."},{"sec":"8. Relativos","w":"que (qu')","es":"que (objeto directo) · que; qué","ex":"Le livre que je lis. La fille que j'aime.","exEs":"El libro que leo. La chica a la que quiero."},{"sec":"8. Relativos","w":"où","es":"donde; en que (tiempo)","ex":"La ville où j'habite. Le jour où il est né.","exEs":"La ciudad donde vivo. El día en que nació."},{"sec":"8. Relativos","w":"dont","es":"del que, de quien, cuyo","ex":"Le film dont je parle. L'ami dont le père…","exEs":"La película de la que hablo. El amigo cuyo padre…"},{"sec":"8. Relativos","w":"lequel, laquelle… + prep.","es":"el cual, la cual…","ex":"La table sur laquelle… L'ami avec lequel…","exEs":"La mesa sobre la cual… El amigo con el que…"},{"sec":"8. Relativos","w":"auquel, à laquelle, auxquels…","es":"al cual, a la cual…","ex":"Le projet auquel je pense.","exEs":"El proyecto en el que pienso."},{"sec":"8. Relativos","w":"duquel, de laquelle…","es":"del cual (tras locución)","ex":"Le parc près duquel j'habite.","exEs":"El parque cerca del cual vivo."},{"sec":"8. Relativos","w":"à qui / avec qui…","es":"a quien / con quien (personas)","ex":"La personne avec qui je travaille.","exEs":"La persona con quien trabajo."},{"sec":"8. Relativos","w":"ce qui","es":"lo que (sujeto)","ex":"Ce qui m'intéresse, c'est…","exEs":"Lo que me interesa es…"},{"sec":"8. Relativos","w":"ce que (ce qu')","es":"lo que (objeto)","ex":"Fais ce que tu veux.","exEs":"Haz lo que quieras."},{"sec":"8. Relativos","w":"ce dont","es":"de lo que, lo que (con «de»)","ex":"Ce dont j'ai besoin.","exEs":"Lo que necesito."},{"sec":"8. Relativos","w":"quoi","es":"qué (tras preposición, sin antecedente)","ex":"C'est ce à quoi je pense.","exEs":"Es en lo que pienso."},{"sec":"9. Conjunciones","w":"et","es":"y","ex":"Toi et moi.","exEs":"Tú y yo."},{"sec":"9. Conjunciones","w":"ou / ou bien","es":"o","ex":"Thé ou café ?","exEs":"¿Té o café?"},{"sec":"9. Conjunciones","w":"mais","es":"pero, sino","ex":"C'est beau mais cher. Pas moi, mais lui.","exEs":"Es bonito pero caro. No yo, sino él."},{"sec":"9. Conjunciones","w":"donc","es":"así que, por lo tanto","ex":"Il pleut, donc je reste.","exEs":"Llueve, así que me quedo."},{"sec":"9. Conjunciones","w":"car","es":"porque, pues (escrito)","ex":"Je reste, car il pleut.","exEs":"Me quedo, pues llueve."},{"sec":"9. Conjunciones","w":"or","es":"ahora bien","ex":"Or, il n'est pas venu.","exEs":"Ahora bien, no vino."},{"sec":"9. Conjunciones","w":"ni… ni","es":"ni… ni","ex":"Je ne bois ni vin ni bière.","exEs":"No bebo ni vino ni cerveza."},{"sec":"9. Conjunciones","w":"soit… soit","es":"o… o; ya sea… ya sea","ex":"Soit lundi, soit mardi.","exEs":"O el lunes o el martes."},{"sec":"9. Conjunciones","w":"non seulement… mais aussi","es":"no solo… sino también","ex":"Non seulement il chante, mais aussi il danse.","exEs":"No solo canta, sino que también baila."},{"sec":"9. Conjunciones","w":"alors","es":"entonces","ex":"Alors, on y va ?","exEs":"Entonces, ¿vamos?"},{"sec":"9. Conjunciones","w":"puis / ensuite","es":"luego, después","ex":"D'abord je mange, puis je sors.","exEs":"Primero como, luego salgo."},{"sec":"9. Conjunciones","w":"pourtant / cependant / toutefois","es":"sin embargo","ex":"C'est difficile, pourtant j'essaie.","exEs":"Es difícil; sin embargo, lo intento."},{"sec":"9. Conjunciones","w":"en effet","es":"efectivamente, de hecho","ex":"Il était fatigué ; en effet, il a dormi 12 heures.","exEs":"Estaba cansado; de hecho, durmió 12 horas."},{"sec":"9. Conjunciones","w":"c'est-à-dire","es":"es decir, o sea","ex":"Demain, c'est-à-dire samedi.","exEs":"Mañana, o sea, el sábado."},{"sec":"9. Conjunciones","w":"par contre / en revanche","es":"en cambio","ex":"Moi, je travaille ; toi, par contre…","exEs":"Yo trabajo; tú, en cambio…"},{"sec":"9. Conjunciones","w":"sinon","es":"si no, de lo contrario","ex":"Pars maintenant, sinon tu seras en retard.","exEs":"Vete ya; si no, llegarás tarde."},{"sec":"9. Conjunciones","w":"aussi","es":"también · también; tan","ex":"Moi aussi.","exEs":"Yo también."},{"sec":"9. Conjunciones","w":"non plus","es":"tampoco","ex":"Moi non plus.","exEs":"Yo tampoco."},{"sec":"9. Conjunciones","w":"quand même","es":"aun así, de todas formas","ex":"Il pleut, mais je sors quand même.","exEs":"Llueve, pero salgo de todas formas."},{"sec":"9. Conjunciones","w":"d'ailleurs","es":"además; por cierto","ex":"D'ailleurs, c'est trop cher.","exEs":"Además, es demasiado caro."},{"sec":"9. Conjunciones","w":"que (qu')","es":"que","ex":"Je pense qu'il a raison.","exEs":"Creo que tiene razón."},{"sec":"9. Conjunciones","w":"parce que","es":"porque","ex":"Je reste parce qu'il pleut.","exEs":"Me quedo porque llueve."},{"sec":"9. Conjunciones","w":"puisque","es":"ya que (causa conocida)","ex":"Puisque tu es là, aide-moi.","exEs":"Ya que estás aquí, ayúdame."},{"sec":"9. Conjunciones","w":"comme","es":"como (causa, al principio)","ex":"Comme il est tard, je pars.","exEs":"Como es tarde, me voy."},{"sec":"9. Conjunciones","w":"quand / lorsque","es":"cuando","ex":"Quand tu arriveras, appelle-moi.","exEs":"Cuando llegues, llámame."},{"sec":"9. Conjunciones","w":"pendant que","es":"mientras","ex":"Pendant que je cuisine, j'écoute la radio.","exEs":"Mientras cocino, escucho la radio."},{"sec":"9. Conjunciones","w":"alors que / tandis que","es":"mientras que (contraste)","ex":"Il travaille alors que moi, je dors.","exEs":"Él trabaja mientras que yo duermo."},{"sec":"9. Conjunciones","w":"si (s')","es":"si (condicional)","ex":"Si tu veux, je viens.","exEs":"Si quieres, voy."},{"sec":"9. Conjunciones","w":"même si","es":"aunque (+ indicativo)","ex":"Je sors même s'il pleut.","exEs":"Salgo aunque llueva."},{"sec":"9. Conjunciones","w":"bien que / quoique [S]","es":"aunque","ex":"Bien qu'il soit fatigué, il travaille.","exEs":"Aunque está cansado, trabaja."},{"sec":"9. Conjunciones","w":"pour que / afin que [S]","es":"para que","ex":"Je parle lentement pour que tu comprennes.","exEs":"Hablo despacio para que entiendas."},{"sec":"9. Conjunciones","w":"avant que [S] / avant de + inf.","es":"antes de que / antes de","ex":"Avant de sortir, je mange.","exEs":"Antes de salir, como."},{"sec":"9. Conjunciones","w":"après que (indicativo) / après + inf. pasado","es":"después de que / después de","ex":"Après avoir mangé, je sors.","exEs":"Después de comer, salgo."},{"sec":"9. Conjunciones","w":"jusqu'à ce que [S]","es":"hasta que","ex":"J'attends jusqu'à ce que tu viennes.","exEs":"Espero hasta que vengas."},{"sec":"9. Conjunciones","w":"dès que / aussitôt que","es":"en cuanto","ex":"Dès que je peux, je t'appelle.","exEs":"En cuanto pueda, te llamo."},{"sec":"9. Conjunciones","w":"depuis que","es":"desde que","ex":"Depuis qu'il habite ici…","exEs":"Desde que vive aquí…"},{"sec":"9. Conjunciones","w":"comme si","es":"como si (+ imperfecto)","ex":"Il parle comme s'il savait tout.","exEs":"Habla como si lo supiera todo."},{"sec":"9. Conjunciones","w":"à condition que [S]","es":"con tal de que, siempre que","ex":"D'accord, à condition que tu sois à l'heure.","exEs":"Vale, siempre que llegues puntual."},{"sec":"9. Conjunciones","w":"à moins que [S]","es":"a menos que","ex":"Je viens, à moins qu'il pleuve.","exEs":"Voy, a menos que llueva."},{"sec":"9. Conjunciones","w":"sans que [S]","es":"sin que","ex":"Il est parti sans que je le voie.","exEs":"Se fue sin que lo viera."},{"sec":"9. Conjunciones","w":"au cas où (+ condicional)","es":"por si, en caso de que","ex":"Prends un parapluie au cas où il pleuvrait.","exEs":"Coge un paraguas por si llueve."},{"sec":"9. Conjunciones","w":"si bien que / de sorte que","es":"de modo que","ex":"Il a plu, si bien que nous sommes restés.","exEs":"Llovió, de modo que nos quedamos."},{"sec":"9. Conjunciones","w":"tellement… que / si… que","es":"tan… que","ex":"J'étais tellement fatigué que je dormais.","exEs":"Estaba tan cansado que me dormía."},{"sec":"10. Indefinidos y cuantificadores","w":"tout, toute, tous, toutes","es":"todo/a/os/as","ex":"Tous les jours. Toute la journée.","exEs":"Todos los días. Todo el día."},{"sec":"10. Indefinidos y cuantificadores","w":"chaque","es":"cada (invariable)","ex":"Chaque jour.","exEs":"Cada día."},{"sec":"10. Indefinidos y cuantificadores","w":"chacun / chacune","es":"cada uno / cada una","ex":"Chacun a le sien.","exEs":"Cada uno tiene el suyo."},{"sec":"10. Indefinidos y cuantificadores","w":"quelques","es":"algunos/as, unos pocos","ex":"Quelques amis.","exEs":"Algunos amigos."},{"sec":"10. Indefinidos y cuantificadores","w":"plusieurs","es":"varios/as","ex":"Plusieurs fois.","exEs":"Varias veces."},{"sec":"10. Indefinidos y cuantificadores","w":"certains / certaines","es":"algunos, ciertos","ex":"Certaines personnes…","exEs":"Algunas personas…"},{"sec":"10. Indefinidos y cuantificadores","w":"quelqu'un","es":"alguien","ex":"Il y a quelqu'un ?","exEs":"¿Hay alguien?"},{"sec":"10. Indefinidos y cuantificadores","w":"quelque chose","es":"algo","ex":"Tu veux quelque chose ?","exEs":"¿Quieres algo?"},{"sec":"10. Indefinidos y cuantificadores","w":"quelque part","es":"en algún sitio","ex":"Je l'ai vu quelque part.","exEs":"Lo he visto en algún sitio."},{"sec":"10. Indefinidos y cuantificadores","w":"(ne…) personne","es":"nadie","ex":"Personne n'est venu.","exEs":"Nadie vino."},{"sec":"10. Indefinidos y cuantificadores","w":"(ne…) rien","es":"nada","ex":"Je ne vois rien.","exEs":"No veo nada."},{"sec":"10. Indefinidos y cuantificadores","w":"(ne…) aucun / aucune","es":"ningún/a, ninguno/a","ex":"Aucun problème.","exEs":"Ningún problema."},{"sec":"10. Indefinidos y cuantificadores","w":"beaucoup (de)","es":"mucho, muchos","ex":"Beaucoup de gens. J'aime beaucoup.","exEs":"Mucha gente. Me gusta mucho."},{"sec":"10. Indefinidos y cuantificadores","w":"très","es":"muy","ex":"Très bien.","exEs":"Muy bien."},{"sec":"10. Indefinidos y cuantificadores","w":"peu (de)","es":"poco (de)","ex":"Peu de temps.","exEs":"Poco tiempo."},{"sec":"10. Indefinidos y cuantificadores","w":"un peu (de)","es":"un poco (de)","ex":"Un peu d'eau.","exEs":"Un poco de agua."},{"sec":"10. Indefinidos y cuantificadores","w":"trop (de)","es":"demasiado","ex":"Trop cher. Trop de bruit.","exEs":"Demasiado caro. Demasiado ruido."},{"sec":"10. Indefinidos y cuantificadores","w":"assez (de)","es":"bastante, suficiente","ex":"J'ai assez de temps.","exEs":"Tengo bastante tiempo."},{"sec":"10. Indefinidos y cuantificadores","w":"tant (de) / tellement (de)","es":"tanto","ex":"Tant de choses !","exEs":"¡Tantas cosas!"},{"sec":"10. Indefinidos y cuantificadores","w":"la plupart (de)","es":"la mayoría (de)","ex":"La plupart des gens.","exEs":"La mayoría de la gente."},{"sec":"10. Indefinidos y cuantificadores","w":"autre","es":"otro","ex":"Un autre café. L'autre jour. D'autres amis.","exEs":"Otro café. El otro día. Otros amigos."},{"sec":"10. Indefinidos y cuantificadores","w":"même","es":"mismo; incluso","ex":"Le même jour. Même lui.","exEs":"El mismo día. Incluso él."},{"sec":"10. Indefinidos y cuantificadores","w":"n'importe quel / qui / quoi","es":"cualquier / cualquiera / cualquier cosa","ex":"N'importe quoi !","exEs":"¡Tonterías! / Cualquier cosa."},{"sec":"10. Indefinidos y cuantificadores","w":"tel / telle","es":"tal","ex":"Une telle idée…","exEs":"Una idea así…"},{"sec":"10. Indefinidos y cuantificadores","w":"plus… que","es":"más… que","ex":"Il est plus grand que moi.","exEs":"Es más alto que yo."},{"sec":"10. Indefinidos y cuantificadores","w":"moins… que","es":"menos… que","ex":"C'est moins cher que ça.","exEs":"Es menos caro que eso."},{"sec":"10. Indefinidos y cuantificadores","w":"aussi… que (adj./adv.)","es":"tan… como","ex":"Il est aussi grand que toi.","exEs":"Es tan alto como tú."},{"sec":"10. Indefinidos y cuantificadores","w":"autant (de)… que (verbo/nombre)","es":"tanto… como","ex":"J'ai autant de livres que toi.","exEs":"Tengo tantos libros como tú."},{"sec":"10. Indefinidos y cuantificadores","w":"plus de / moins de + número","es":"más de / menos de","ex":"Plus de dix personnes.","exEs":"Más de diez personas."},{"sec":"10. Indefinidos y cuantificadores","w":"le plus / le moins","es":"el más / el menos","ex":"Le plus beau de tous.","exEs":"El más bonito de todos."},{"sec":"10. Indefinidos y cuantificadores","w":"meilleur / pire","es":"mejor / peor (adjetivo)","ex":"Le meilleur restaurant.","exEs":"El mejor restaurante."},{"sec":"10. Indefinidos y cuantificadores","w":"mieux","es":"mejor (adverbio) · mejor (adv.)","ex":"Je vais mieux.","exEs":"Estoy mejor."},{"sec":"11. La negación","w":"ne (n')… pas","es":"no","ex":"Je ne comprends pas.","exEs":"No entiendo."},{"sec":"11. La negación","w":"non","es":"no (respuesta)","ex":"Non, merci.","exEs":"No, gracias."},{"sec":"11. La negación","w":"ne… jamais","es":"nunca","ex":"Je ne bois jamais de café.","exEs":"Nunca tomo café."},{"sec":"11. La negación","w":"ne… plus","es":"ya no","ex":"Je n'habite plus ici.","exEs":"Ya no vivo aquí."},{"sec":"11. La negación","w":"ne… pas encore","es":"todavía no","ex":"Il n'est pas encore arrivé.","exEs":"Todavía no ha llegado."},{"sec":"11. La negación","w":"ne… rien","es":"nada","ex":"Je ne vois rien.","exEs":"No veo nada."},{"sec":"11. La negación","w":"ne… personne","es":"nadie","ex":"Je ne connais personne.","exEs":"No conozco a nadie."},{"sec":"11. La negación","w":"ne… aucun(e)","es":"ningún/a","ex":"Je n'ai aucune idée.","exEs":"No tengo ni idea."},{"sec":"11. La negación","w":"ne… ni… ni","es":"ni… ni","ex":"Je n'ai ni temps ni argent.","exEs":"No tengo ni tiempo ni dinero."},{"sec":"11. La negación","w":"ne… nulle part","es":"en ninguna parte","ex":"Je ne le trouve nulle part.","exEs":"No lo encuentro en ninguna parte."},{"sec":"11. La negación","w":"ne… pas du tout","es":"en absoluto","ex":"Ce n'est pas du tout vrai.","exEs":"No es verdad en absoluto."},{"sec":"11. La negación","w":"ne… que","es":"solo, solamente (¡no es negación!)","ex":"Je n'ai que dix euros.","exEs":"Solo tengo diez euros."},{"w":"maintenant","es":"ahora","sec":"12. Adverbios funcionales"},{"w":"en ce moment","es":"en este momento","sec":"12. Adverbios funcionales"},{"w":"d'abord","es":"primero","sec":"12. Adverbios funcionales"},{"w":"ensuite / puis","es":"luego, después","sec":"12. Adverbios funcionales"},{"w":"avant","es":"antes · antes (de)","sec":"12. Adverbios funcionales"},{"w":"après","es":"después · después (de)","sec":"12. Adverbios funcionales"},{"w":"déjà","es":"ya","sec":"12. Adverbios funcionales"},{"w":"encore","es":"todavía; otra vez","sec":"12. Adverbios funcionales"},{"w":"toujours","es":"siempre; todavía","sec":"12. Adverbios funcionales"},{"w":"jamais","es":"nunca; alguna vez","sec":"12. Adverbios funcionales"},{"w":"souvent","es":"a menudo","sec":"12. Adverbios funcionales"},{"w":"d'habitude","es":"normalmente","sec":"12. Adverbios funcionales"},{"w":"parfois / quelquefois","es":"a veces","sec":"12. Adverbios funcionales"},{"w":"de temps en temps","es":"de vez en cuando","sec":"12. Adverbios funcionales"},{"w":"tout de suite","es":"enseguida","sec":"12. Adverbios funcionales"},{"w":"bientôt","es":"pronto (dentro de poco)","sec":"12. Adverbios funcionales"},{"w":"tôt","es":"temprano","sec":"12. Adverbios funcionales"},{"w":"tard","es":"tarde","sec":"12. Adverbios funcionales"},{"w":"en retard / en avance","es":"con retraso / con antelación","sec":"12. Adverbios funcionales"},{"w":"à l'heure","es":"puntual","sec":"12. Adverbios funcionales"},{"w":"hier / aujourd'hui / demain","es":"ayer / hoy / mañana","sec":"12. Adverbios funcionales"},{"w":"avant-hier / après-demain","es":"anteayer / pasado mañana","sec":"12. Adverbios funcionales"},{"w":"ce matin / ce soir","es":"esta mañana / esta tarde-noche","sec":"12. Adverbios funcionales"},{"w":"cette nuit","es":"esta noche (de madrugada)","sec":"12. Adverbios funcionales"},{"w":"il y a…","es":"hace… (pasado)","sec":"12. Adverbios funcionales"},{"w":"depuis…","es":"desde hace…","sec":"12. Adverbios funcionales"},{"w":"dans…","es":"dentro de… (futuro)","sec":"12. Adverbios funcionales"},{"w":"tout à l'heure","es":"hace un rato; dentro de un rato","sec":"12. Adverbios funcionales"},{"w":"enfin / finalement","es":"por fin; finalmente","sec":"12. Adverbios funcionales"},{"w":"pendant ce temps","es":"mientras tanto","sec":"12. Adverbios funcionales"},{"w":"ici","es":"aquí","sec":"12. Adverbios funcionales"},{"w":"là","es":"ahí; aquí (coloquial)","sec":"12. Adverbios funcionales"},{"w":"là-bas","es":"allí, allá","sec":"12. Adverbios funcionales"},{"w":"y","es":"allí (pronombre) · allí; en eso","sec":"12. Adverbios funcionales"},{"w":"en haut","es":"arriba","sec":"12. Adverbios funcionales"},{"w":"en bas","es":"abajo","sec":"12. Adverbios funcionales"},{"w":"dessus","es":"encima","sec":"12. Adverbios funcionales"},{"w":"dessous","es":"debajo","sec":"12. Adverbios funcionales"},{"w":"dedans","es":"dentro","sec":"12. Adverbios funcionales"},{"w":"dehors","es":"fuera","sec":"12. Adverbios funcionales"},{"w":"devant","es":"delante","sec":"12. Adverbios funcionales"},{"w":"derrière","es":"detrás","sec":"12. Adverbios funcionales"},{"w":"près","es":"cerca","sec":"12. Adverbios funcionales"},{"w":"loin","es":"lejos","sec":"12. Adverbios funcionales"},{"w":"partout","es":"en todas partes","sec":"12. Adverbios funcionales"},{"w":"nulle part","es":"en ninguna parte","sec":"12. Adverbios funcionales"},{"w":"ailleurs","es":"en otro sitio","sec":"12. Adverbios funcionales"},{"w":"quelque part","es":"en algún sitio","sec":"12. Adverbios funcionales"},{"w":"ainsi / comme ça","es":"así","sec":"12. Adverbios funcionales"},{"w":"bien / mal","es":"bien / mal","sec":"12. Adverbios funcionales"},{"w":"seulement","es":"solo, solamente","sec":"12. Adverbios funcionales"},{"w":"surtout","es":"sobre todo","sec":"12. Adverbios funcionales"},{"w":"presque","es":"casi","sec":"12. Adverbios funcionales"},{"w":"au moins","es":"al menos","sec":"12. Adverbios funcionales"},{"w":"peut-être","es":"quizás","sec":"12. Adverbios funcionales"},{"w":"sans doute","es":"probablemente","sec":"12. Adverbios funcionales"},{"w":"vraiment","es":"de verdad, realmente","sec":"12. Adverbios funcionales"},{"w":"plutôt","es":"más bien","sec":"12. Adverbios funcionales"},{"w":"environ","es":"aproximadamente","sec":"12. Adverbios funcionales"},{"w":"même","es":"incluso","sec":"12. Adverbios funcionales"},{"w":"ensemble","es":"juntos","sec":"12. Adverbios funcionales"},{"w":"exprès","es":"a propósito, adrede","sec":"12. Adverbios funcionales"},{"w":"oui / non / si","es":"sí / no / sí (contradiciendo)","sec":"12. Adverbios funcionales"},{"w":"bien sûr","es":"por supuesto","sec":"12. Adverbios funcionales"},{"w":"à mon avis / selon moi","es":"en mi opinión","sec":"13. Conectores y muletillas"},{"w":"pour moi","es":"para mí","sec":"13. Conectores y muletillas"},{"w":"d'abord","es":"en primer lugar","sec":"13. Conectores y muletillas"},{"w":"enfin","es":"por último; por fin","sec":"13. Conectores y muletillas"},{"w":"par exemple","es":"por ejemplo","sec":"13. Conectores y muletillas"},{"w":"en fait","es":"en realidad, de hecho","sec":"13. Conectores y muletillas"},{"w":"d'une part… d'autre part","es":"por una parte… por otra","sec":"13. Conectores y muletillas"},{"w":"d'un côté… de l'autre","es":"por un lado… por otro","sec":"13. Conectores y muletillas"},{"w":"bref","es":"en resumen, en fin","sec":"13. Conectores y muletillas"},{"w":"finalement","es":"al final","sec":"13. Conectores y muletillas"},{"w":"heureusement","es":"por suerte","sec":"13. Conectores y muletillas"},{"w":"malheureusement","es":"por desgracia","sec":"13. Conectores y muletillas"},{"w":"de toute façon","es":"de todas formas","sec":"13. Conectores y muletillas"},{"w":"en tout cas","es":"en cualquier caso","sec":"13. Conectores y muletillas"},{"w":"au fait","es":"por cierto","sec":"13. Conectores y muletillas"},{"w":"à propos","es":"a propósito","sec":"13. Conectores y muletillas"},{"w":"voilà","es":"ahí está; eso es","sec":"13. Conectores y muletillas"},{"w":"voici","es":"aquí está","sec":"13. Conectores y muletillas"},{"w":"bon / ben","es":"bueno, pues","sec":"13. Conectores y muletillas"},{"w":"du coup","es":"así que, entonces (coloquial) · así que (coloq.)","sec":"13. Conectores y muletillas"},{"w":"d'accord","es":"de acuerdo","sec":"13. Conectores y muletillas"},{"w":"ça va","es":"vale; ¿qué tal?","sec":"13. Conectores y muletillas"},{"w":"tu sais / vous savez","es":"sabes / sabe","sec":"13. Conectores y muletillas"},{"w":"genre","es":"en plan (coloquial)","sec":"13. Conectores y muletillas"},{"sec":"14. Trampas para hispanohablantes","w":"toujours","es":"siempre; todavía","note":"Error típico: No ver el sentido de «todavía»: Il est toujours là = Sigue aquí."},{"sec":"14. Trampas para hispanohablantes","w":"tout de suite","es":"enseguida","note":"Error típico: Confundirlo con «de suite» (= seguidos)."},{"sec":"14. Trampas para hispanohablantes","w":"tout à l'heure","es":"hace un rato; dentro de un rato","note":"Error típico: Creer que es «a toda hora»."},{"sec":"14. Trampas para hispanohablantes","w":"pourtant","es":"sin embargo","note":"Error típico: Confundirlo con «por tanto» (= donc)."},{"sec":"14. Trampas para hispanohablantes","w":"car","es":"porque, pues","note":"Error típico: Creer que es «coche» (= voiture)."},{"sec":"14. Trampas para hispanohablantes","w":"or","es":"ahora bien","note":"Error típico: Creer que solo es «oro»."},{"sec":"14. Trampas para hispanohablantes","w":"quand même","es":"aun así, de todas formas","note":"Error típico: Traducirlo como «cuando mismo»."},{"sec":"14. Trampas para hispanohablantes","w":"personne","es":"nadie; persona","note":"Error típico: Olvidar que con ne significa «nadie»."},{"sec":"14. Trampas para hispanohablantes","w":"ne… que","es":"solo","note":"Error típico: Creer que es una negación."},{"sec":"14. Trampas para hispanohablantes","w":"dont","es":"del que, cuyo","note":"Error típico: Confundirlo con «donde» (= où)."},{"sec":"14. Trampas para hispanohablantes","w":"si","es":"si; sí (contradiciendo); tan","note":"Error típico: No usarlo para contradecir una pregunta negativa."},{"sec":"14. Trampas para hispanohablantes","w":"sous","es":"debajo de","note":"Error típico: Confundirlo con «sus» (= ses, leurs)."},{"sec":"14. Trampas para hispanohablantes","w":"plus","es":"más; ya no (ne… plus)","note":"Error típico: Il n'y a plus de pain = Ya no hay pan."},{"sec":"14. Trampas para hispanohablantes","w":"encore","es":"todavía; otra vez; más","note":"Error típico: Encore un café = Otro café."},{"w":"lorsque","es":"cuando","sec":"Glosario"},{"w":"à moins que","es":"a menos que","sec":"Glosario"},{"w":"afin que","es":"para que","sec":"Glosario"},{"w":"meilleur","es":"mejor (adj.)","sec":"Glosario"},{"w":"ainsi","es":"así","sec":"Glosario"},{"w":"alors que","es":"mientras que","sec":"Glosario"},{"w":"moins","es":"menos","sec":"Glosario"},{"w":"au, aux","es":"al, a los","sec":"Glosario"},{"w":"mon, ma, mes","es":"mi, mis","sec":"Glosario"},{"w":"au cas où","es":"por si","sec":"Glosario"},{"w":"ne… pas","es":"no","sec":"Glosario"},{"w":"aucun(e)","es":"ningún/a","sec":"Glosario"},{"w":"aujourd'hui","es":"hoy","sec":"Glosario"},{"w":"nos, notre","es":"nuestro","sec":"Glosario"},{"w":"autant","es":"tanto","sec":"Glosario"},{"w":"avant que","es":"antes de que","sec":"Glosario"},{"w":"ou","es":"o","sec":"Glosario"},{"w":"oui","es":"sí","sec":"Glosario"},{"w":"bien que","es":"aunque","sec":"Glosario"},{"w":"par contre","es":"en cambio","sec":"Glosario"},{"w":"c'est","es":"es","sec":"Glosario"},{"w":"parfois","es":"a veces","sec":"Glosario"},{"w":"ce, cet, cette, ces","es":"este, esta, estos","sec":"Glosario"},{"w":"ce que / ce qui","es":"lo que","sec":"Glosario"},{"w":"celui, celle","es":"el, la (que)","sec":"Glosario"},{"w":"cependant","es":"sin embargo","sec":"Glosario"},{"w":"plupart (la)","es":"la mayoría","sec":"Glosario"},{"w":"chacun(e)","es":"cada uno/a","sec":"Glosario"},{"w":"combien","es":"cuánto","sec":"Glosario"},{"w":"pour que","es":"para que","sec":"Glosario"},{"w":"puis","es":"luego","sec":"Glosario"},{"w":"de (d')","es":"de","sec":"Glosario"},{"w":"quel(le)","es":"qué, cuál","sec":"Glosario"},{"w":"demain","es":"mañana","sec":"Glosario"},{"w":"rien","es":"nada","sec":"Glosario"},{"w":"dès que","es":"en cuanto","sec":"Glosario"},{"w":"selon","es":"según","sec":"Glosario"},{"w":"elle(s)","es":"ella(s)","sec":"Glosario"},{"w":"son, sa, ses","es":"su, sus","sec":"Glosario"},{"w":"ensuite","es":"luego","sec":"Glosario"},{"w":"tel(le)","es":"tal","sec":"Glosario"},{"w":"ton, ta, tes","es":"tu, tus","sec":"Glosario"},{"w":"eux","es":"ellos","sec":"Glosario"},{"w":"tout, tous","es":"todo, todos","sec":"Glosario"},{"w":"hier","es":"ayer","sec":"Glosario"},{"w":"il(s)","es":"él / ellos","sec":"Glosario"},{"w":"il y a","es":"hay; hace","sec":"Glosario"},{"w":"un, une","es":"un, una","sec":"Glosario"},{"w":"voici / voilà","es":"aquí está / ahí está","sec":"Glosario"},{"w":"vos, votre","es":"vuestro; su","sec":"Glosario"},{"w":"la, le, l', les","es":"el, la, los, las","sec":"Glosario"},{"w":"lequel, laquelle","es":"el cual; cuál","sec":"Glosario"}]}