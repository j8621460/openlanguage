{"code":"zu","es":"Zulú","en":"Zulu","native":"isiZulu","tts":"zu-ZA","entries":[{"w":"na-","pron":"na","es":"con; y","ex":"Ngihlala nodadewethu.","exEs":"Vivo con mi hermana.","sec":"3. Locativos y preposiciones"},{"w":"nga-","pron":"nga","es":"con (instrumento), en (medio); sobre","ex":"Ngihamba ngesitimela.","exEs":"Viajo en tren.","sec":"3. Locativos y preposiciones"},{"w":"kwa-","pron":"kwa","es":"en casa de; de","ex":"kwaZulu · kwaThabo","exEs":"tierra de los zulúes · en casa de Thabo","sec":"3. Locativos y preposiciones"},{"w":"phezu kwa-","pron":"phé-zu kwa","es":"encima de, sobre","ex":"Incwadi iphezu kwetafula.","exEs":"El libro está sobre la mesa.","sec":"3. Locativos y preposiciones"},{"w":"phansi kwa-","pron":"phán-si kwa","es":"debajo de","ex":"phansi kombhede","exEs":"debajo de la cama","sec":"3. Locativos y preposiciones"},{"w":"phakathi kwa-","pron":"pha-ká-thi kwa","es":"dentro de; entre","ex":"phakathi kwendlu · phakathi kwami nawe","exEs":"dentro de la casa · entre tú y yo","sec":"3. Locativos y preposiciones"},{"w":"phandle kwa-","pron":"phán-dle kwa","es":"fuera de","ex":"phandle kwedolobha","exEs":"fuera de la ciudad","sec":"3. Locativos y preposiciones"},{"w":"phambi kwa-","pron":"phám-bi kwa","es":"delante de","ex":"phambi kwendlu","exEs":"delante de la casa","sec":"3. Locativos y preposiciones"},{"w":"emuva kwa-","pron":"e-mú-va kwa","es":"detrás de; después de","ex":"emuva kwesikole · emuva komsebenzi","exEs":"detrás de la escuela · después del trabajo","sec":"3. Locativos y preposiciones"},{"w":"eduze kwa-","pron":"e-dú-ze kwa","es":"cerca de, junto a","ex":"eduze kwemakethe","exEs":"cerca del mercado","sec":"3. Locativos y preposiciones"},{"w":"eceleni kwa-","pron":"e-ǀe-lé-ni kwa","es":"al lado de","ex":"eceleni kwebhange","exEs":"al lado del banco","sec":"3. Locativos y preposiciones"},{"w":"kude na-","pron":"kú-de na","es":"lejos de","ex":"kude nedolobha","exEs":"lejos de la ciudad","sec":"3. Locativos y preposiciones"},{"w":"ngaphamb